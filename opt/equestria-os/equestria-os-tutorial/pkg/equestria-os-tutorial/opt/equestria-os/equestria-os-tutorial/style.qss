QWidget {
    background-color: @base@;
    color: @text@;
    font-family: "Noto Sans", sans-serif;
}

/* Верхняя панель */
QWidget#TopBar {
    background-color: @mantle@;
    border-bottom: 1px solid @surface0@;
}
QLabel#LogoLabel {
    color: @accent@;
}

/* Выпадающий список языков.
   Важно: без правил ::drop-down/::down-arrow — иначе Qt перестаёт
   рисовать нативную стрелку. */
QComboBox#LangCombo {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    min-width: 46px;
}
QComboBox#LangCombo:hover {
    border: 1px solid @accent@;
}
QComboBox QAbstractItemView {
    background-color: @surface0@;
    color: @text@;
    selection-background-color: @surface2@;
    border: 1px solid @surface1@;
    outline: none;
}

/* Слайды */
QLabel#SlideTitle {
    color: @accent@;
    font-size: 32px;
    font-weight: bold;
}
QTextBrowser#SlideText {
    background-color: transparent;
    border: none;
    font-size: 18px;
}

/* Синие кнопки внутри слайда */
QPushButton#ActionBtn {
    background-color: @accent2@;
    color: @mantle@;
    font-size: 15px;
    font-weight: bold;
    padding: 10px 20px;
    margin: 0px 5px; /* Отступ между кнопками */
    border-radius: 10px;
    border: none;
}
QPushButton#ActionBtn:hover {
    background-color: @accent@;
}

/* Нижняя панель навигации */
QWidget#BottomBar {
    background-color: @mantle@;
    border-top: 1px solid @surface0@;
}

QPushButton#NavBtnPrev {
    background-color: transparent;
    color: @subtext@;
    font-size: 15px;
    font-weight: bold;
    border: none;
    padding: 8px 16px;
}
QPushButton#NavBtnPrev:hover {
    color: @text@;
}

QPushButton#NavBtnNext {
    background-color: @green@;
    color: @mantle@;
    font-size: 15px;
    font-weight: bold;
    border-radius: 8px;
    padding: 8px 24px;
}
QPushButton#NavBtnNext:hover {
    background-color: @accent2@;
}

QPushButton#NavBtnFinish {
    background-color: @accent@;
    color: @mantle@;
    font-size: 15px;
    font-weight: bold;
    border-radius: 8px;
    padding: 8px 24px;
}
QPushButton#NavBtnFinish:hover {
    background-color: @accent_hover@;
}

/* Скроллбар */
QScrollBar:vertical {
    background: @base@;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: @surface1@;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: @surface2@;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* Чекбокс автостарта */
QCheckBox#AutostartCheckbox {
    color: @subtext@;
    font-size: 13px;
    spacing: 6px;
}
QCheckBox#AutostartCheckbox:hover {
    color: @text@;
}
QCheckBox#AutostartCheckbox::indicator {
    width: 18px;
    height: 18px;
    image: url(@icon:cb_unchecked@);
}
QCheckBox#AutostartCheckbox::indicator:hover {
    image: url(@icon:cb_unchecked_hover@);
}
QCheckBox#AutostartCheckbox::indicator:checked {
    image: url(@icon:cb_checked@);
}

/* Точки прогресса */
QLabel#ProgressDot {
    color: @surface1@;
    font-size: 20px;
}
QLabel#ProgressDot[active="true"] {
    color: @accent@;
}
