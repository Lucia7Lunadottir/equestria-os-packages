# Maintainer: Equestria OS
pkgname=equestria-gpu
pkgver=1.0
pkgrel=1
pkgdesc="Graphics card drivers and diagnostics (PyQt6)"
arch=('any')
license=('custom')
depends=('python-pyqt6' 'equestria-qt-kit' 'pciutils')
optdepends=('nvidia-utils: сведения и настройки NVIDIA'
            'vulkan-tools: проверка Vulkan и DX12 (vulkaninfo)'
            'mangohud: оверлей FPS в играх'
            'gamemode: режим производительности в играх')
source=("equestria_gpu.py" "equestria-gpu.desktop" "i18n.json")
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/equestria_gpu.py" "$pkgdir/usr/bin/equestria-gpu"
    install -Dm644 "$srcdir/equestria-gpu.desktop" "$pkgdir/usr/share/applications/equestria-gpu.desktop"
    install -Dm644 "$srcdir/i18n.json" "$pkgdir/usr/share/equestria-gpu/i18n.json"
}
