/* Базовый фон */
QWidget#root { background-color: @base@; }

QLabel#TitleLabel {
    font-size: 26px; color: rgb(240, 240, 240); font-weight: bold; margin-bottom: 20px;
}

QLineEdit#SearchField, QComboBox#CategoryDropdown {
    border-radius: 8px; background-color: @surface0@; color: white;
    padding: 8px 12px; border: 1px solid @accent%80@;
}

QComboBox QAbstractItemView {
    background-color: @surface0@; color: white;
    selection-background-color: @surface1@; border: 1px solid @accent%80@;
    outline: none;
}

QScrollArea#PackageList {
    background-color: @surface0%30@; border-radius: 12px; border: 1px solid @surface1@;
}
#ScrollContent { background-color: @surface0%30@; }

QFrame#PackageRow { border-bottom: 1px solid @surface1@; background-color: transparent; }
QFrame#PackageRow:hover { background-color: @surface1@; }


/* =========================================
 *  КНОПКИ (100% перекрытие системной темы KDE)
 *  ========================================= */

/* Главная кнопка удаления в списке */
QPushButton#ListDeleteBtn {
    background-color: @accent%70@; color: white;
    border-radius: 6px; padding: 6px 15px; font-weight: bold;
    border: 1px solid @accent%70@;
}
QPushButton#ListDeleteBtn:hover {
    background-color: @accent@; border: 1px solid @accent@;
}

/* Кнопка удаления внутри модального окна */
QPushButton#ModalDeleteBtn {
    background-color: @accent%70@; color: white;
    border-radius: 8px; padding: 10px 15px; font-weight: bold;
    border: 1px solid @accent%70@;
}
QPushButton#ModalDeleteBtn:hover {
    background-color: @accent@; border: 1px solid @accent@;
}

/* Пагинация под списком пакетов */
QPushButton#PaginationBtn {
    background-color: @surface1@; color: white;
    border-radius: 6px; padding: 6px 15px; font-weight: bold;
    border: 1px solid @accent%70@;
}
QPushButton#PaginationBtn:hover {
    background-color: @accent%35@;
}
QPushButton#PaginationBtn:disabled {
    background-color: @surface0@; color: @subtext@; border: 1px solid @surface1@;
}

/* Кнопка отмены внутри модального окна */
QPushButton#ModalCancelBtn {
    background-color: @surface2@; color: white;
    border-radius: 8px; padding: 10px 15px; font-weight: bold;
    border: 1px solid @surface2@;
}
QPushButton#ModalCancelBtn:hover {
    background-color: @surface2@; border: 1px solid @surface2@;
}

/* Выпадающий список языков.
   Важно: без правил ::drop-down/::down-arrow — иначе Qt перестаёт
   рисовать нативную стрелку. */
QComboBox#LangCombo {
    background-color: @surface0@; color: @text@;
    border: 1px solid @surface1@; border-radius: 4px; padding: 2px 8px;
    min-width: 48px;
}
QComboBox#LangCombo:hover {
    background-color: @surface0@; border: 1px solid @accent%80@;
}

/* =========================================
 *  МОДАЛЬНОЕ ОКНО И ПЕРЕКРЫТИЕ
 *  ========================================= */
QFrame#ModalOverlay {
    background-color: @crust/220@; /* Черное перекрытие */
}

#ModalBox {
background-color: @surface0%55@; border: 2px solid @accent%80@; border-radius: 12px;
}

/* Переключатель «также удалить файлы программы» (SwitchRow) рисуется
   вручную в ui_pkg.py — QSS для него не нужен. */
