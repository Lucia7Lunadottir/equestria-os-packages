QWidget#root {
    background-color: @base@;
}

QWidget {
    color: @text@;
    font-family: "Noto Sans", sans-serif;
    font-size: 14px;
}

/* ЗАГОЛОВОК ТЕПЕРЬ ПОДХВАТЫВАЕТ ШРИФТ ИЗ ПИТОНА */
QLabel#TitleLabel {
    font-family: {{TITLE_FONT}}, "Noto Sans", sans-serif;
    color: @accent@;
    margin-bottom: 10px;
    background: transparent;
}

QFrame#LeftPanel {
    background-color: @surface0%30@;
    border-radius: 15px;
    border: 1px solid @surface0@;
}

QLabel#CategoryHeader {
    color: @accent2@;
    font-weight: bold;
    padding-left: 5px;
    margin-top: 10px;
    text-transform: uppercase;
    font-size: 11px;
}

QListWidget#CategoryList {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget#CategoryList::item {
    padding: 10px;
    border-radius: 8px;
    color: @subtext@;
}

QListWidget#CategoryList::item:hover {
    background-color: @surface0@;
}

QListWidget#CategoryList::item:selected {
    background-color: @accent2@;
    color: @on_accent2@;
    font-weight: bold;
}

QPushButton#NavBtn {
    background-color: @surface0@;
    color: white;
    border-radius: 8px;
    padding: 10px;
    text-align: left;
    border: 1px solid @surface1@;
}

QPushButton#NavBtn:hover {
    background-color: @surface1@;
    border: 1px solid @accent2@;
}

QPushButton#IntegrityBtn {
    background-color: @accent2@;
    color: @on_accent2@;
    border-radius: 10px;
    font-weight: bold;
    font-size: 14px;
    border: none;
}

QPushButton#IntegrityBtn:hover {
    background-color: @accent2@;
}

/* Диалог выбора режима очистки кэша: системный QMessageBox светлый,
   красим под тему приложения. Кнопкам в коде назначены DetailActionBtn /
   CacheCleanBtn / DetailBackBtn — они берут стили ниже. */
QMessageBox {
    background-color: @base@;
}
QMessageBox QLabel {
    color: @text@;
    font-size: 13px;
}

QPushButton#CacheCleanBtn {
    background-color: @yellow@;
    color: @on_yellow@;
    border-radius: 10px;
    font-weight: bold;
    font-size: 14px;
    border: none;
}

QPushButton#CacheCleanBtn:hover {
    background-color: @yellow@;
}

/* Кнопка ручного обновления базы pacman — полноразмерная, в одном ряду
   с Check System Files / Clean Package Cache / Update System */
QPushButton#RefreshDbBtn {
    background-color: @accent@;
    color: @on_accent@;
    border-radius: 10px;
    font-weight: bold;
    font-size: 14px;
    border: none;
}
QPushButton#RefreshDbBtn:hover {
    background-color: @accent_hover@;
}
QPushButton#RefreshDbBtn:disabled {
    background-color: @surface1@;
    color: @subtext@;
}

/* Баннер «база устарела» / индикатор хода обновления над списком App Store */
QFrame#DbStaleBanner {
    background-color: @yellow/38@;
    border: 1px solid @yellow@;
    border-radius: 8px;
}
QLabel#DbStaleLabel {
    color: @yellow@;
    font-size: 13px;
    background: transparent;
}
QProgressBar#DbRefreshProgress {
    background-color: @yellow/51@;
    border: none;
    border-radius: 3px;
}
QProgressBar#DbRefreshProgress::chunk {
    background-color: @yellow@;
    border-radius: 3px;
}

QPushButton#UpdateAllBtn {
    background-color: @green@;
    color: @on_green@;
    border-radius: 10px;
    font-weight: bold;
    font-size: 15px;
    border: none;
}

QPushButton#UpdateAllBtn:hover {
    background-color: @accent2@;
}

QFrame#RightPanel {
    background-color: @surface0%30@;
    border-radius: 15px;
    border: 1px solid @surface0@;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#AppScrollContent, QWidget#ScrollContent {
    background-color: transparent;
}

QLineEdit#SearchField, QComboBox#CategoryDropdown, QPlainTextEdit#SearchField {
    background-color: @crust@;
    border: 1px solid @surface0@;
    border-radius: 8px;
    padding: 8px 12px;
    color: white;
}

QLineEdit#SearchField:focus, QPlainTextEdit#SearchField:focus {
    border: 1px solid @accent@;
}

/* A custom border/background on QComboBox makes Qt stop drawing its native
   drop-down arrow, so it must be redrawn explicitly (same fix applies to
   QComboBox#SettingsDropdown below). */
QComboBox#CategoryDropdown::drop-down, QComboBox#SettingsDropdown::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}

QComboBox#CategoryDropdown::down-arrow, QComboBox#SettingsDropdown::down-arrow {
    /* Base64 data: URIs silently fail to render for QSS image properties on
       this Qt build (verified — same is true of the checkbox icons below),
       so this must be a real file, resolved via {{BASE_PATH}} at load time. */
    image: url(@icon:chevron_down@);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: @crust@;
    color: white;
    selection-background-color: @surface0@;
    border: 1px solid @surface0@;
    outline: none;
}

/* Without explicit ::item rules, Qt paints the keyboard-"current" (but not
   yet selected) row with the native system highlight color instead of the
   theme's selection-background-color above. */
QComboBox QAbstractItemView::item {
    background-color: transparent;
    color: white;
    padding: 6px 10px;
    border: none;
}

QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected {
    background-color: @surface0@;
    color: white;
}

QFrame#AppRow, QFrame#PackageRow {
    background-color: @surface0/76@;
    border-radius: 10px;
    margin-bottom: 2px;
    border: 1px solid transparent;
}

QFrame#AppRow:hover, QFrame#PackageRow:hover {
    background-color: @surface0/153@;
    border: 1px solid @surface1@;
}

QPushButton#AppToggle {
    background-color: @crust@;
    color: transparent;
    border: 2px solid @surface1@;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#AppToggle:checked {
    background-color: @accent@;
    color: @on_accent@;
    border: 2px solid @accent@;
}

QPushButton#ListInstallBtn, QPushButton#InstallSelectedBtn {
    background-color: @accent@;
    color: @on_accent@;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
    border: none;
}

QPushButton#ListInstallBtn:hover, QPushButton#InstallSelectedBtn:hover {
    background-color: @accent_hover@;
}

QPushButton#ListInstallBtn:disabled, QPushButton#InstallSelectedBtn:disabled {
    background-color: @surface1@;
    color: @subtext@;
}

QPushButton#LangBtn {
    background-color: transparent;
    color: @subtext@;
    border: 1px solid @surface0@;
    border-radius: 4px;
    padding: 4px; /* Чуть увеличили отступ для сетки */
    font-size: 10px;
}

QPushButton#LangBtn:hover {
    background-color: @surface0@;
    color: white;
}

QPushButton#LangBtn[active="true"] {
    background-color: @accent@;
    color: @on_accent@;
    border: 1px solid @accent@;
    font-weight: bold;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: @surface0@;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: @surface1@;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: @surface0@;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: @surface1@;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Detail back button */
QPushButton#DetailBackBtn {
    background-color: transparent;
    color: @accent2@;
    border: 1px solid @accent2@;
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: bold;
}
QPushButton#DetailBackBtn:hover {
    background-color: @accent2/38@;
}
QPushButton#DetailBackBtn:disabled {
    color: @subtext@;
    border: 1px solid @surface1@;
}

/* Detail action button (Install / Remove) */
QPushButton#DetailActionBtn {
    background-color: @accent@;
    color: @on_accent@;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 15px;
    border: none;
}
QPushButton#DetailActionBtn:hover {
    background-color: @accent_hover@;
}
QPushButton#DetailActionBtn:disabled {
    background-color: @surface1@;
    color: @subtext@;
}

/* Screenshot scroll area */
QScrollArea#ScreenshotScroll {
    background: transparent;
    border: none;
}

/* Кнопки пагинации */
QPushButton#PaginationBtn {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: bold;
}
QPushButton#PaginationBtn:hover {
    background-color: @surface1@;
    border: 1px solid @accent2@;
}
QPushButton#PaginationBtn:disabled {
    background-color: @mantle@;
    color: @surface1@;
    border: 1px solid @surface0@;
}


/* --- Settings Dialog Layout Extensions --- */
QDialog#SettingsDialog {
    background-color: @base@;
}

QGroupBox#SettingsGroup {
    color: @accent2@;
    font-weight: bold;
    border: 1px solid @surface0@;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 15px;
}

/* Premium Checkbox Toggle with Embedded Base64 SVG Vectors */
QCheckBox#SettingsToggle {
    color: @text@;
    font-size: 14px;
    spacing: 12px;
    padding: 6px;
}

QCheckBox#SettingsToggle::indicator {
    width: 22px;
    height: 22px;
    border-radius: 6px;
}

/* Unchecked state: Dark input background with crisp red cross icon placeholder */
QCheckBox#SettingsToggle::indicator:unchecked {
    background-color: @crust@;
    border: 2px solid @surface0@;
    image: url(data:image/svg+xml;base64,);
}

QCheckBox#SettingsToggle::indicator:unchecked:hover {
    background-color: @surface0@;
    border: 2px solid @accent2@;
}

/* Checked state: Smooth Catppuccin Green accent filling with dark contrast checkmark vector */
QCheckBox#SettingsToggle::indicator:checked {
    background-color: @green@;
    border: 2px solid @green@;
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMTExMTFiIiBzdHJva2Utd2lkdGg9IjQiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBvbHlsaW5lIHBvaW50cz0iMjAgNiA5IDE3IDQgMTIiLz48L3N2Zz4=);
}

QCheckBox#SettingsToggle::indicator:checked:hover {
    background-color: @accent2@;
    border: 2px solid @accent2@;
}

QCheckBox#SettingsToggle::indicator:disabled {
    background-color: @mantle@;
    border: 2px solid @surface0@;
}

QComboBox#SettingsDropdown {
    background-color: @crust@;
    border: 1px solid @surface0@;
    border-radius: 6px;
    padding: 4px 8px;
    color: white;
    min-height: 25px;
}

QComboBox#SettingsDropdown QAbstractItemView {
    background-color: @crust@;
    color: white;
    selection-background-color: @surface0@;
    border: 1px solid @surface0@;
}

QPushButton#SettingsSaveBtn {
    background-color: @green@;
    color: @on_green@;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: bold;
    font-size: 13px;
    border: none;
}

QPushButton#SettingsSaveBtn:hover {
    background-color: @accent2@;
}

QPushButton#SettingsCancelBtn {
    background-color: @surface0@;
    color: white;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: bold;
    font-size: 13px;
    border: 1px solid @surface1@;
}

QPushButton#SettingsCancelBtn:hover {
    background-color: @surface1@;
}

/* Install/Remove progress panel (see install_panel.py) */
QDialog#InstallProgressDialog {
    background-color: @base@;
}

QLabel#InstallTitleLabel {
    font-size: 16px;
    font-weight: bold;
    color: @text@;
}

QLabel#InstallStatusLabel, QLabel#InstallStatusOk,
QLabel#InstallStatusWarn, QLabel#InstallStatusError {
    font-size: 12px;
    color: @subtext@;
}

QLabel#InstallStatusOk {
    color: @green@;
    font-weight: bold;
}

QLabel#InstallStatusWarn {
    color: @yellow@;
    font-weight: bold;
}

QLabel#InstallStatusError {
    color: @red@;
    font-weight: bold;
}

QPlainTextEdit#InstallLogView {
    background-color: @crust@;
    color: @green@;
    font-family: "Noto Sans Mono", monospace;
    font-size: 12px;
    border: 1px solid @surface0@;
    border-radius: 8px;
    padding: 8px;
}

QProgressBar#InstallProgressBar {
    background-color: @accent2/51@;
    border: none;
    border-radius: 3px;
    max-height: 6px;
}
QProgressBar#InstallProgressBar::chunk {
    background-color: @accent2@;
    border-radius: 3px;
}
