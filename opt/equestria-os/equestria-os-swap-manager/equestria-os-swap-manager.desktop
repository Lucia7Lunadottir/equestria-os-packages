Keywords[es]=swap;memoria;swappiness;fstab;ram;
Keywords[pt]=swap;memória;swappiness;fstab;ram;
Keywords[pl]=swap;pamięć;swappiness;fstab;ram;
Keywords[uk]=swap;пам'ять;swappiness;fstab;ram;
