/* Equestria OS Global Style */

QWidget {
    color: @text@; /* Catppuccin Text */
    background-color: transparent;
    font-family: sans-serif;
    font-size: 14px;
}

#CentralBg {
background-color: @base@; /* фон окна — как у остальных приложений */
}

#AppTitle {
font-family: {{TITLE_FONT}};
font-size: 24px;
font-weight: bold;
color: @accent@; /* Catppuccin Pink */
margin-bottom: 5px;
}

#SectionLabel {
font-weight: bold;
color: @subtext@; /* Catppuccin Subtext1 */
margin-top: 5px;
}

#StatusLabel {
color: @subtext@; /* Catppuccin Subtext0 */
font-size: 13px;
}

#Divider {
color: @surface0@; /* Catppuccin Surface1 */
}

/* Элементы ввода */
QLineEdit, QSpinBox {
    background-color: @base@; /* Catppuccin Base */
    border: 1px solid @surface0@; /* Catppuccin Surface1 */
    border-radius: 6px;
    padding: 6px 10px;
    color: @text@;
}

QLineEdit:focus, QSpinBox:focus {
    border-color: @accent@; /* Pink Accent */
}

QLineEdit#DestEdit {
    font-family: monospace;
    font-size: 13px;
}

/* Кнопки */
QPushButton {
    background-color: @surface0@; /* Catppuccin Surface1 */
    border: none;
    border-radius: 6px;
    padding: 5px 14px;
    font-weight: bold;
    color: @text@;
}

QPushButton:hover {
    background-color: @surface1@; /* Catppuccin Surface2 */
}

QPushButton:pressed {
    background-color: @base@; /* Catppuccin Base */
}

QPushButton:disabled {
    color: @subtext@; /* Catppuccin Overlay0 */
    background-color: @mantle@; /* Catppuccin Mantle */
}

/* Акцентная кнопка (Применить) */
QPushButton#RelocateBtn {
    background-color: @accent@; /* Pink */
    color: @on_accent@; /* Crust */
}

QPushButton#RelocateBtn:hover {
    background-color: @accent_hover@; /* Flamingo (светлее) */
}

/* Кнопка опасности (Удалить) */
QPushButton#DangerBtn {
    background-color: @red@; /* Red */
    color: @on_red@;
}

QPushButton#DangerBtn:hover {
    background-color: @red%80@; /* Maroon (светлее) */
}

/* Кнопка Обновить */
QPushButton#BrowseBtn {
    padding: 4px 10px;
    font-size: 13px;
}

/* Языковые кнопки */
/* Language dropdown: styled by the runtime-appended QComboBox rules
   in swap_app.py; kept here only as a hover accent. */
QComboBox#LangCombo:hover {
    border: 1px solid @accent@;
    color: @text@;
}

/* --- СТИЛИЗАЦИЯ ГАЛОЧКИ (FIX) --- */

QCheckBox#SwapCheckBox {
    color: @text@;
    spacing: 10px; /* Отступ текста от галочки */
    font-weight: bold;
}

/* Основа галочки */
QCheckBox#SwapCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid @surface0@; /* Surface1 */
    background-color: @base@; /* Base */
}

/* Состояние Hover */
QCheckBox#SwapCheckBox::indicator:hover {
    border-color: @accent@; /* Pink Accent */
}

/* Состояние Включено (Checked) */
QCheckBox#SwapCheckBox::indicator:checked {
    border-color: @accent@; /* Pink Accent */
    background-color: @accent@; /* Розовый фон */

    /* ИНЪЕКЦИЯ СГЕНЕРИРОВАННОГО SVG */
    image: url(@icon:check_mark@);
}

/* Состояние Checked + Hover */
QCheckBox#SwapCheckBox::indicator:checked:hover {
    background-color: @accent_hover@; /* Светлее */
    border-color: @accent_hover@;
}

/* Состояние Disabled */
QCheckBox#SwapCheckBox::indicator:disabled {
    border-color: @mantle@;
    background-color: @mantle@;
}

/* --- Прогресс бар --- */
QFrame#ProgressFrame {
    background-color: @mantle@;
    border-radius: 8px;
    padding: 10px;
}

QProgressBar {
    background-color: @surface0@;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: @accent@; /* Pink Accent */
    border-radius: 4px;
}
