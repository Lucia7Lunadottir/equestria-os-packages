pkgdesc="Календарь с фазами луны и напоминаниями (PyQt6)"
arch=('any')
license=('custom')
depends=('python-pyqt6' 'equestria-qt-kit' 'qt6-multimedia')
source=("equestria_calendar.py" "equestria-calendar.desktop" "i18n.json")
sha256sums=('25f6791ab74e23dfc31fdb532e6eca5d25edb8dfc1475306fb62a6e588b44171'
            '700ca2c0a056c715d544a0190d660d387e6308c1812b2ebe8c90531ca6f35fa9'
            'd128faa99b7b3cff6084d5ec8b13481296bab3d56e01f9e308fa5ba4daf1d4fe')

package() {
    install -Dm755 "$srcdir/equestria_calendar.py" "$pkgdir/usr/bin/equestria-calendar"
    install -Dm644 "$srcdir/equestria-calendar.desktop" "$pkgdir/usr/share/applications/equestria-calendar.desktop"
    install -Dm644 "$srcdir/i18n.json" "$pkgdir/usr/share/equestria-calendar/i18n.json"
}
