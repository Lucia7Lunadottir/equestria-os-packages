# Maintainer: Equestria OS
pkgname=equestria-calendar
pkgver=1.0
pkgrel=8
pkgdesc="Календарь с фазами луны и напоминаниями (PyQt6)"
arch=('any')
license=('custom')
depends=('python-pyqt6' 'equestria-qt-kit>=1.3-2' 'qt6-multimedia')
source=("equestria_calendar.py" "equestria-calendar.desktop")
sha256sums=('c23be8f80fc221771062ef6abb844e4f5b976376c5792d5282b2bc0fae6f7f83' '067aaf0f69eed52a309d18b7a4f385bd1a31ea642882262b6caaea2ab0ecd169')

package() {
    local libdir="$pkgdir/usr/lib/equestria-calendar"
    install -Dm755 "$srcdir/equestria_calendar.py" "$libdir/equestria_calendar.py"
    for f in "$startdir"/equestria_calendar_app/*.py; do
        install -Dm644 "$f" "$libdir/equestria_calendar_app/$(basename "$f")"
    done
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/equestria-calendar/equestria_calendar.py "$pkgdir/usr/bin/equestria-calendar"
    install -Dm644 "$srcdir/equestria-calendar.desktop" "$pkgdir/usr/share/applications/equestria-calendar.desktop"
    for f in "$startdir"/locales/*.json; do
        install -Dm644 "$f" "$pkgdir/usr/share/equestria-calendar/locales/$(basename "$f")"
    done
}
