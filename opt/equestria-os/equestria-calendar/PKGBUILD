package() {
    install -Dm755 "$srcdir/equestria_calendar.py" "$pkgdir/usr/bin/equestria-calendar"
    install -Dm644 "$srcdir/equestria-calendar.desktop" "$pkgdir/usr/share/applications/equestria-calendar.desktop"
    install -Dm644 "$srcdir/i18n.json" "$pkgdir/usr/share/equestria-calendar/i18n.json"
}
