/* Цвета — роли общей темы Equestria OS (equestria_kit.qt.render_qss):
   @base@ фон, @surface0..2@ карточки, @text@/@subtext@ текст, @accent@ акцент,
   @accent2@ второй акцент, @on_accent@ текст на акцентной заливке, @red@/@yellow@/@green@ статусы;
   @роль/NN@ — с прозрачностью, @роль%NN@ — NN% цвета поверх фона. */

/* Base container */
QWidget#root { background-color: @base@; }

/* Language dropdown.
   No ::drop-down/::down-arrow rules on purpose: declaring them makes Qt
   stop drawing the native arrow. */
QComboBox#LangCombo {
    background-color: @surface0@; color: @text@;
    border: 1px solid @surface1@; border-radius: 4px; padding: 3px 8px;
    font-size: 11px; font-family: sans-serif; min-width: 46px;
}
QComboBox#LangCombo:hover {
    border: 1px solid @accent@; color: @text@;
}
QComboBox#LangCombo QAbstractItemView {
    background-color: @surface0@; color: @text@;
    border: 1px solid @surface1@;
    selection-background-color: @surface2@;
    outline: none;
}

/* App title — font-family injected at runtime via {{TITLE_FONT}} */
QLabel#AppTitle {
    color: @accent@;
    font-size: 22px;
    font-weight: bold;
    font-family: {{TITLE_FONT}};
    qproperty-alignment: 'AlignLeft';
}

/* Section labels */
QLabel#SectionLabel {
    color: @accent2@;
    font-size: 13px;
    font-weight: bold;
    font-family: sans-serif;
}

/* Divider */
QFrame#Divider {
    background-color: @surface1@;
    border: none;
}

/* Scroll area for sources */
QScrollArea#SourceScrollArea {
    background-color: transparent;
    border: 1px solid @surface1@;
    border-radius: 6px;
}
QWidget#SourceContainer { background-color: transparent; }

/* Source and destination line edits */
QLineEdit#SourceEdit, QLineEdit#DestEdit {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    font-family: sans-serif;
}
QLineEdit#SourceEdit:focus, QLineEdit#DestEdit:focus {
    border: 1px solid @accent@;
}

/* Generic Browse button */
QPushButton#BrowseBtn {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-family: sans-serif;
}
QPushButton#BrowseBtn:hover {
    background-color: @surface1@;
    border: 1px solid @accent@;
}

/* Add Source button — dashed ghost border, blue text */
QPushButton#AddSourceBtn {
    background-color: transparent;
    color: @accent2@;
    border: 1px dashed @accent2@;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-family: sans-serif;
}
QPushButton#AddSourceBtn:hover {
    background-color: @surface0@;
}

/* Remove button — transparent, red text */
QPushButton#RemoveBtn {
    background-color: transparent;
    color: @red@;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
    font-family: sans-serif;
}
QPushButton#RemoveBtn:hover {
    background-color: @surface0@;
    border: 1px solid @red@;
}

/* Symlink toggle — identical to AutostartToggle */
QPushButton#SymlinkToggle {
    background-color: @base@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    color: transparent;
    font-family: sans-serif;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 2px;
}
QPushButton#SymlinkToggle:checked {
    background-color: @accent@;
    border: 1px solid @accent@;
    color: @on_accent@;
}

/* Relocate button — pink fill (same as active NavBtn) */
QPushButton#RelocateBtn {
    background-color: @accent@;
    color: @on_accent@;
    border: 1px solid @accent@;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    font-weight: bold;
    font-family: sans-serif;
}
QPushButton#RelocateBtn:hover {
    background-color: @accent_hover@;
    border: 1px solid @accent_hover@;
}
QPushButton#RelocateBtn:disabled {
    background-color: @surface1@;
    color: @subtext/150@;
    border: 1px solid @surface1@;
}

/* NTFS warning */
QLabel#NtfsWarning {
    background-color: @yellow%10@;
    color: @yellow@;
    border: 1px solid @yellow@;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    font-family: sans-serif;
}

/* Status label */
QLabel#StatusLabel {
    color: @green@;
    font-size: 13px;
    font-family: sans-serif;
    qproperty-alignment: 'AlignLeft';
}
QLabel#StatusLabel[status="error"] {
    color: @red@;
}

/* Checkbox styling */
QCheckBox {
    color: @accent2@; /* Голубой текст, как у SectionLabel */
    font-size: 13px;
    font-family: sans-serif;
    spacing: 8px; /* Отступ между квадратиком и текстом */
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @surface1@;
    border-radius: 4px;
    background-color: @surface0@;
}

QCheckBox::indicator:hover {
    border: 1px solid @accent@;
}

QCheckBox::indicator:checked {
    background-color: @accent@;
    border: 1px solid @accent@;
}

/* Window / scroll background */
QMainWindow, QWidget#CentralBg { background-color: @base@; }
QScrollArea { background-color: transparent; border: none; }
QScrollArea > QWidget > QWidget { background-color: transparent; }

QScrollBar:vertical {
    background: @base@;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: @surface2@;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ComboBox */
QComboBox#SourceEdit {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    font-family: sans-serif;
}
QComboBox#SourceEdit:focus { border: 1px solid @accent@; }
QComboBox#SourceEdit QAbstractItemView {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    selection-background-color: @surface2@;
    selection-color: @text@;
    outline: none;
}

/* Progress frame */
QFrame#ProgressFrame {
    background-color: @base@;
    border-top: 1px solid @surface1@;
}
QProgressBar {
    background-color: @surface0@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    max-height: 6px;
}
QProgressBar::chunk {
    background-color: @accent@;
    border-radius: 4px;
}

/* fstab options widget */
QFrame#OptionsFrame {
    background-color: @surface0%40@;
    border: 1px solid @surface1@;
    border-radius: 8px;
}
QLabel#OptionsSubLabel {
    color: @surface2@;
    font-size: 11px;
    font-family: sans-serif;
}
/* Foldout «Расширенные» — раскрывает разметку дисков */
QPushButton#FoldoutBtn {
    background-color: transparent;
    color: @accent@;
    border: 1px solid @surface1@;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: bold;
    font-family: sans-serif;
    text-align: left;
}
QPushButton#FoldoutBtn:hover {
    border-color: @accent@;
    background-color: @surface0%65@;
}
QPushButton#FoldoutBtn:checked {
    border-color: @accent@;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}
QLineEdit#SmallEdit {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 12px;
    font-family: monospace;
}
QLineEdit#SmallEdit:focus { border: 1px solid @accent@; }

/* fstab health / orphaned entries panel */
QFrame#FstabHealthFrame {
    border: 1px solid @yellow@;
    border-radius: 8px;
    background-color: @yellow%7@;
}
QLabel#FstabHealthTitle {
    color: @yellow@;
    font-size: 13px;
    font-weight: bold;
    font-family: sans-serif;
}
QLabel#FstabHealthHint {
    color: @yellow%65@;
    font-size: 12px;
    font-family: sans-serif;
}
QFrame#OrphanEntryFrame {
    background-color: @yellow%10@;
    border: 1px solid @yellow%35@;
    border-radius: 6px;
}
QLabel#OrphanWarnLabel {
    color: @yellow@;
    font-size: 12px;
    font-weight: bold;
    font-family: sans-serif;
}
QLabel#OrphanInfoLabel {
    color: @subtext@;
    font-size: 12px;
    font-family: monospace;
}

/* Format / danger zone */
QFrame#DangerFrame {
    border: 1px solid @red@;
    border-radius: 8px;
    background-color: @red%8@;
}
QLabel#DangerLabel {
    color: @red@;
    font-size: 13px;
    font-weight: bold;
    font-family: sans-serif;
}
QLabel#DangerWarn {
    color: @yellow@;
    font-size: 12px;
    font-family: sans-serif;
}
QPushButton#DangerBtn {
    background-color: transparent;
    color: @red@;
    border: 1px solid @red@;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    font-weight: bold;
    font-family: sans-serif;
}
QPushButton#DangerBtn:hover { background-color: @red/30@; }
QPushButton#DangerBtn:disabled {
    color: @subtext/150@;
    border-color: @surface1@;
}

/* Терминальный предпросмотр команды mkfs */
QLineEdit#CmdPreview, QLabel#CmdPreview {
    background-color: @crust@;
    color: @green@;
    border: 1px solid @surface1@;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-family: monospace;
}

/* Описание выбранной ФС в зоне форматирования */
QLabel#FmtDesc {
    color: @subtext@;
    font-size: 11px;
    font-family: sans-serif;
}

/* Ошибка валидации метки */
QLabel#FmtLabelError {
    color: @red@;
    font-size: 11px;
    font-family: sans-serif;
}

/* Диалог подтверждения форматирования */
QDialog#FmtConfirm { background-color: @base@; }
QLabel#DlgText {
    color: @text@;
    font-size: 13px;
    font-family: sans-serif;
}

/* Профи-режим: разметка дисков */
QFrame#ProFrame {
    border: 1px solid @accent@;
    border-radius: 8px;
    background-color: @accent%6@;
}
QLabel#ProLabel {
    color: @accent@;
    font-size: 13px;
    font-weight: bold;
    font-family: sans-serif;
}
QFrame#PartRow {
    background-color: @surface0%65@;
    border: 1px solid @surface1@;
    border-radius: 6px;
}
QLabel#PartLabel {
    color: @text@;
    font-size: 12px;
    font-family: monospace;
}
QLabel#FreeLabel {
    color: @green@;
    font-size: 12px;
    font-family: monospace;
}
QDoubleSpinBox#SmallEdit {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 13px;
    font-family: monospace;
}

/* Кнопка в «опасном» состоянии (например «Отключить автомонтирование») */
QPushButton#RelocateBtn[state="danger"] {
    background-color: transparent;
    color: @red@;
    border: 1px solid @red@;
}
QPushButton#RelocateBtn[state="danger"]:hover { background-color: @red/30@; }

/* Сведения о выбранном разделе (UUID, ФС, размер) — справочный текст, не статус */
QLabel#PartInfoLabel {
    color: @subtext@;
    font-size: 13px;
    font-family: sans-serif;
    qproperty-alignment: 'AlignLeft';
}
