/* Базовый фон */
QWidget#root {
    background-color: @base@; color: @text@; font-size: 14px;
}

/* Шапка */
QFrame#Header {
    background-color: @mantle@; border-bottom: 1px solid @surface0@;
}
QLabel#TitleLabel {
    color: @accent@; font-weight: bold; font-size: 18px;
}

/* Панели */
QLabel#SectionTitle {
    color: @green@; font-weight: bold; margin-bottom: 8px;
}

QLineEdit#SearchField {
    background-color: @surface0@; border: 1px solid @surface1@;
    border-radius: 6px; color: @text@; padding: 6px 10px;
}
QLineEdit#SearchField:focus { border: 1px solid @accent@; }

/* Списки */
QScrollArea#CountryList, QScrollArea#MirrorsScroll {
    background-color: @mantle@; border-radius: 8px; border: 1px solid @surface0@;
}
QWidget#ScrollContent { background-color: @mantle@; }

/* Строка страны */
QFrame#CountryRow {
    border-bottom: 1px solid @surface0@; background-color: transparent;
}
QFrame#CountryRow:hover { background-color: @surface0@; }

QLabel#CountryName { color: @text@; }
QLabel#CountryCode { color: @accent2@; font-weight: bold; }
QLabel#CountryMirrors { color: @subtext@; }


/* ========================================================= */
/* ФИКС: Стилизация текстовой галочки (вместо QCheckBox)     */
/* ========================================================= */
QPushButton#CountryToggle {
    background-color: @base@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    color: transparent; /* Скрываем текст ✔, когда выключено */
    font-family: sans-serif;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 2px;
}
QPushButton#CountryToggle:checked {
    background-color: @green@;
    border: 1px solid @green@;
    color: @on_green@; /* Тёмная галочка на светло-зелёном фоне */
}


/* Статус и счетчики */
QLabel#SelectedCount { color: @green@; font-weight: bold; margin-top: 6px; }
QLabel#CurrentMirrors { color: @accent2@; font-size: 12px; }
QLabel#StatusLabel { color: @yellow@; font-size: 13px; padding: 6px 16px; }

/* Подвал и Кнопки */
QFrame#Footer {
    background-color: @mantle@; border-top: 1px solid @surface0@;
}
QPushButton#PrimaryBtn {
    background-color: @green@; color: @on_green@;
    border-radius: 6px; padding: 8px 20px; font-weight: bold; font-size: 14px; border: 1px solid @green@;
}
QPushButton#PrimaryBtn:hover { background-color: @accent2@; border: 1px solid @accent2@; }
QPushButton#PrimaryBtn:disabled { background-color: @surface1@; color: @subtext@; border: 1px solid @surface1@; }

QPushButton#SecondaryBtn {
    background-color: @surface0@; color: @text@;
    border-radius: 6px; padding: 8px 20px; font-weight: bold; font-size: 14px; border: 1px solid @surface0@;
}
QPushButton#SecondaryBtn:hover { background-color: @surface1@; border: 1px solid @surface1@; }

/* Окно загрузки */
QFrame#LoadingOverlay { background-color: @base/220@; }
QLabel#LoadingText { color: @accent@; font-size: 18px; font-weight: bold; }

/* Чекбокс автообновления */
QCheckBox#AutoCheckbox {
    color: @text@;
    font-size: 13px;
    spacing: 6px;
}
QCheckBox#AutoCheckbox::indicator {
    width: 16px; height: 16px;
    border-radius: 4px;
    border: 1px solid @surface1@;
    background-color: @base@;
}
QCheckBox#AutoCheckbox::indicator:checked {
    background-color: @green@;
    border: 1px solid @green@;
}
