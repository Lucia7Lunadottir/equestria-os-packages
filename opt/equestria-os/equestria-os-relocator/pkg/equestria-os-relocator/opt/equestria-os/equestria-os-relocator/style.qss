/* Base container */
QWidget#root { background-color: @base@; }

/* Language dropdown.
   No ::drop-down/::down-arrow rules on purpose: declaring them makes Qt
   stop drawing the native arrow. */
QComboBox#LangCombo {
    background-color: @surface0@; color: @text@;
    border: 1px solid @surface1@; border-radius: 4px; padding: 3px 8px;
    font-size: 11px; font-family: sans-serif; min-width: 46px;
}
QComboBox#LangCombo:hover {
    border: 1px solid @accent@; color: @text@;
}
QComboBox#LangCombo QAbstractItemView {
    background-color: @surface0@; color: @text@;
    border: 1px solid @surface1@;
    selection-background-color: @surface2@;
    outline: none;
}

/* App title */
QLabel#AppTitle {
    color: @accent@;
    font-size: 22px;
    font-weight: bold;
    font-family: sans-serif;
    qproperty-alignment: 'AlignLeft';
}

/* Section labels */
QLabel#SectionLabel {
    color: @accent2@;
    font-size: 13px;
    font-weight: bold;
    font-family: sans-serif;
}

/* Divider */
QFrame#Divider {
    background-color: @surface1@;
    border: none;
}

/* Scroll area for sources */
QScrollArea#SourceScrollArea {
    background-color: transparent;
    border: 1px solid @surface1@;
    border-radius: 6px;
}
QWidget#SourceContainer { background-color: transparent; }

/* Source and destination line edits */
QLineEdit#SourceEdit, QLineEdit#DestEdit {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    font-family: sans-serif;
}
QLineEdit#SourceEdit:focus, QLineEdit#DestEdit:focus {
    border: 1px solid @accent@;
}

/* Generic Browse button */
QPushButton#BrowseBtn {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-family: sans-serif;
}
QPushButton#BrowseBtn:hover {
    background-color: @surface1@;
    border: 1px solid @accent@;
}

/* Add Source button — dashed ghost border, blue text */
QPushButton#AddSourceBtn {
    background-color: transparent;
    color: @accent2@;
    border: 1px dashed @accent2@;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-family: sans-serif;
}
QPushButton#AddSourceBtn:hover {
    background-color: @surface0@;
}

/* Remove button — transparent, red text */
QPushButton#RemoveBtn {
    background-color: transparent;
    color: @red@;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
    font-family: sans-serif;
}
QPushButton#RemoveBtn:hover {
    background-color: @surface0@;
    border: 1px solid @red@;
}

/* Symlink toggle — identical to AutostartToggle */
QPushButton#SymlinkToggle {
    background-color: @base@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    color: transparent;
    font-family: sans-serif;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 2px;
}
QPushButton#SymlinkToggle:checked {
    background-color: @accent@;
    border: 1px solid @accent@;
    color: @on_accent@;
}

/* Relocate button — pink fill (same as active NavBtn) */
QPushButton#RelocateBtn {
    background-color: @accent@;
    color: @on_accent@;
    border: 1px solid @accent@;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    font-weight: bold;
    font-family: sans-serif;
}
QPushButton#RelocateBtn:hover {
    background-color: @accent_hover@;
    border: 1px solid @accent_hover@;
}
QPushButton#RelocateBtn:disabled {
    background-color: @surface1@;
    color: @subtext@;
    border: 1px solid @surface1@;
}

/* NTFS warning */
QLabel#NtfsWarning {
    background-color: @yellow%10@;
    color: @yellow@;
    border: 1px solid @yellow@;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    font-family: sans-serif;
}

/* Status label */
QLabel#StatusLabel {
    color: @green@;
    font-size: 13px;
    font-family: sans-serif;
    qproperty-alignment: 'AlignLeft';
}
QLabel#StatusLabel[status="error"] {
    color: @red@;
}
