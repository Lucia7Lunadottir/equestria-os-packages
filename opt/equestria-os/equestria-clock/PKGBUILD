# Maintainer: Equestria OS
pkgname=equestria-clock
pkgver=1.0
pkgrel=7
pkgdesc="Будильник, таймер и секундомер (PyQt6)"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python-pyqt6' 'equestria-qt-kit>=1.3-3' 'pipewire')
source=("equestria_clock.py" "equestria-clock.desktop")
sha256sums=('da0666a00eae805598525ffc6cdcc838018496264510a53cd53dc8da297d3cfa' 'e3f979cae8f68f996519958133bb31043759d1eda05289cbaf10eadb5f1a470d')

package() {
    local libdir="$pkgdir/usr/lib/equestria-clock"
    install -Dm755 "$srcdir/equestria_clock.py" "$libdir/equestria_clock.py"
    for f in "$startdir"/equestria_clock_app/*.py; do
        install -Dm644 "$f" "$libdir/equestria_clock_app/$(basename "$f")"
    done
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/equestria-clock/equestria_clock.py "$pkgdir/usr/bin/equestria-clock"
    install -Dm644 "$srcdir/equestria-clock.desktop" "$pkgdir/usr/share/applications/equestria-clock.desktop"
    for f in "$startdir"/locales/*.json; do
        install -Dm644 "$f" "$pkgdir/usr/share/equestria-clock/locales/$(basename "$f")"
    done
}
