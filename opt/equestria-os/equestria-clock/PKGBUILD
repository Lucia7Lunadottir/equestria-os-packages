source=("equestria_clock.py" "equestria-clock.desktop" "i18n.json")
sha256sums=('eacba69e71089f3a3f95b5dfa3bea556969756891ffa6769b7c531d596b59baf'
            'e3f979cae8f68f996519958133bb31043759d1eda05289cbaf10eadb5f1a470d'
            '7bb94e38e9d65e75e4444a6c642f033bb7e63f1f67a5e917dbc54923c954cf78')

package() {
    install -Dm755 "$srcdir/equestria_clock.py" "$pkgdir/usr/bin/equestria-clock"
    install -Dm644 "$srcdir/equestria-clock.desktop" "$pkgdir/usr/share/applications/equestria-clock.desktop"
    install -Dm644 "$srcdir/i18n.json" "$pkgdir/usr/share/equestria-clock/i18n.json"
}
