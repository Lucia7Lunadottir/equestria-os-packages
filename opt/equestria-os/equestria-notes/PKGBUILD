# Maintainer: Equestria OS
pkgname=equestria-notes
pkgver=1.0
pkgrel=4
pkgdesc="Markdown notes with images and to-do lists (PyQt6)"
arch=('any')
license=('custom')
depends=('python-pyqt6' 'equestria-qt-kit>=1.3-2')
source=("equestria_notes.py" "equestria-notes.desktop")
sha256sums=('bc9fe8c6a56c2719e8907c1437698b2d09b9fff2a65a8c6aa6dbbaf0fee2771a' '0a0b06c8259c0eaab1e5dcd83992fa1db2f0f16a1f63720a940504b2ea828d7a')

package() {
    local libdir="$pkgdir/usr/lib/equestria-notes"
    install -Dm755 "$srcdir/equestria_notes.py" "$libdir/equestria_notes.py"
    for f in "$startdir"/equestria_notes_app/*.py; do
        install -Dm644 "$f" "$libdir/equestria_notes_app/$(basename "$f")"
    done
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/equestria-notes/equestria_notes.py "$pkgdir/usr/bin/equestria-notes"
    install -Dm644 "$srcdir/equestria-notes.desktop" "$pkgdir/usr/share/applications/equestria-notes.desktop"
    for f in "$startdir"/locales/*.json; do
        install -Dm644 "$f" "$pkgdir/usr/share/equestria-notes/locales/$(basename "$f")"
    done
}
