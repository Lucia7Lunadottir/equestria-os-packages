post_install() {
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=backlight 2>/dev/null || true

    # Plasmashell watchdog: включаем для всех пользователей (со следующего
    # входа в систему) и сразу запускаем у тех, кто залогинен прямо сейчас.
    systemctl --global enable pg-plasmashell-watchdog.service >/dev/null 2>&1 || true
    local uid
    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        systemctl --user --machine="${uid}@.host" daemon-reload >/dev/null 2>&1 || true
        systemctl --user --machine="${uid}@.host" restart pg-plasmashell-watchdog.service >/dev/null 2>&1 || true
    done
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl --global disable pg-plasmashell-watchdog.service >/dev/null 2>&1 || true
}
