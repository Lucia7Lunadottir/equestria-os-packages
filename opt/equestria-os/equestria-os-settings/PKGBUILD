# Maintainer: Equestria OS Team

pkgname=equestria-os-settings
pkgver=1.7.0
pkgrel=5
pkgdesc="Unified settings panel for Equestria OS — all system tools in one place"
arch=('any')
url="https://github.com/Lucia7Lunadottir"
license=('GPL')
depends=('python-pyqt6')
install=equestria-os-settings.install
optdepends=(
    'equestria-os-disk-manager: disk management module'
    'equestria-os-package-manager: package removal module'
    'equestria-os-proton-starter: Proton/Wine settings module'
    'pg-rankmirrors: mirror ranking module'
    'pg-update: auto-update notification settings'
    'equestria-os-services-manager: systemd service management module'
    'equestria-os-save-point: system snapshot management module'
    'equestria-os-task-panel-changer: taskbar style module'
    'equestria-os-tutorial: interactive OS tour module'
    'equestria-os-character-theme: character theme switcher module'
    'equestria-os-software-center: software installation module'
    'equestria-os-swap-manager: swap and memory pressure management module'
    'plasma-workspace: Open KDE System Settings button'
    'networkmanager: internet module — DNS and connection management'
    'iw: internet module — WiFi power-save detection'
    'speedtest-cli: internet module — speed test'
    'ddcutil: brightness module — real hardware control for external monitors via DDC/CI'
    'brightnessctl: brightness module — real hardware control for laptop/internal panels'
    'pciutils: gpu module — GPU detection via lspci'
    'mesa-utils: gpu module — OpenGL renderer detection (glxinfo)'
    'vulkan-tools: gpu module — Vulkan status detection (vulkaninfo)'
    'qt6-tools: gpu module — KWin compositor status (qdbus6)'
    'alsa-utils: microphone module — mic boost/gain control (amixer, alsactl)'
    'pipewire: microphone module — test recording (pw-record, pw-play)'
)

package() {
    local _lib="$pkgdir/opt/equestria-os/$pkgname"
    install -dm755 "$_lib"

    # Core Python files
    for f in main.py app.py base_module.py embedded_module.py style.qss \
              equestria_cyrillic.ttf equestria-os-settings.png packages.json; do
        install -Dm644 "$startdir/$f" "$_lib/$f"
    done

    # Modules
    install -dm755 "$_lib/modules"
    for f in "$startdir"/modules/*.py; do
        install -Dm644 "$f" "$_lib/modules/$(basename "$f")"
    done

    # Locales
    install -dm755 "$_lib/locales"
    for f in "$startdir"/locales/*.json; do
        install -Dm644 "$f" "$_lib/locales/$(basename "$f")"
    done

    # Icons
    install -dm755 "$_lib/icons"
    for f in "$startdir"/icons/*; do
        install -Dm644 "$f" "$_lib/icons/$(basename "$f")"
    done

    # /usr/bin wrapper
    install -dm755 "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/$pkgname" << 'WRAPPER'
#!/bin/bash
cd /opt/equestria-os/equestria-os-settings/
exec python3 main.py "$@"
WRAPPER
    chmod 755 "$pkgdir/usr/bin/$pkgname"

    # Desktop entry
    install -Dm644 "$startdir/$pkgname.desktop" \
        "$pkgdir/usr/share/applications/$pkgname.desktop"

    # Icon
    install -Dm644 "$startdir/$pkgname.png" \
        "$pkgdir/usr/share/pixmaps/$pkgname.png"

    # udev rule — grants the active local user write access to sysfs
    # backlight devices so brightness control (this app and KDE Powerdevil)
    # doesn't need a password prompt on every change.
    install -Dm644 "$startdir/90-equestria-backlight.rules" \
        "$pkgdir/usr/lib/udev/rules.d/90-equestria-backlight.rules"

    # Display watchdog — opt-in via the GPU module, restarts the display
    # manager if the NVIDIA/KWin black-screen-after-resume bug is detected.
    install -Dm755 "$startdir/pg-display-recover" \
        "$pkgdir/usr/bin/pg-display-recover"
    install -Dm644 "$startdir/pg-display-recover.service" \
        "$pkgdir/usr/lib/systemd/system/pg-display-recover.service"

    # Resource guard — opt-in via the GPU module, sends a desktop notification
    # when RAM or VRAM run low. Notification only: never closes or kills
    # anything. Runs as a user service, no root required.
    install -Dm755 "$startdir/pg-resource-guard" \
        "$pkgdir/usr/bin/pg-resource-guard"
    install -Dm644 "$startdir/pg-resource-guard.service" \
        "$pkgdir/usr/lib/systemd/user/pg-resource-guard.service"
}
