QMainWindow, QDialog { background: @base@; }
QWidget { color: @text@; font-size: 14px; }
QLabel { background: transparent; }
QLabel#logo { font-size: 18px; font-weight: 800; color: @accent@; }
QLabel#title { font-size: 22px; font-weight: 800; }
QLabel#hint { color: @subtext@; font-size: 13px; }
QLabel#h2 { color: @accent@; font-size: 14px; font-weight: 700; }
QLabel#big { font-size: 26px; font-weight: 800; }
QLabel#rowname { font-size: 15px; font-weight: 600; }
QLabel#chip { background: @mantle@; border-radius: 9px; padding: 3px 10px; font-size: 12px; font-weight: 700; color: @subtext@; }
QLabel#chip[lvl="ok"] { color: @green@; }
QLabel#chip[lvl="warn"] { color: @yellow@; }
QLabel#chip[lvl="fail"] { color: @red@; }
QFrame#side { background: @crust@; }
QFrame#card { background: @surface0@; border-radius: 14px; }
QFrame#hero { background: @mantle@; border-radius: 16px; }

QPushButton { background: @surface0@; border: none; border-radius: 10px; padding: 9px 16px; font-weight: 600; }
QPushButton:hover { background: @surface1@; }
QPushButton:pressed { background: @surface2@; }
QPushButton:disabled { color: @surface2@; background: @mantle@; }
QPushButton#primary { background: @accent@; color: @on_accent@; }
QPushButton#primary:hover { background: @accent_hover@; }
QPushButton#primary:pressed { background: @accent%70@; }
QPushButton#primary:disabled { background: @surface1@; color: @surface2@; }
QPushButton#danger { background: @red@; color: @on_red@; }
QPushButton#danger:hover { background: @red%85@; }
QPushButton#small { padding: 6px 12px; font-size: 13px; border-radius: 9px; }
QPushButton#nav { background: transparent; text-align: left; padding: 12px 16px; border-radius: 10px;
    font-size: 15px; color: @subtext@; }
QPushButton#nav:hover { background: @mantle@; color: @text@; }
QPushButton#nav:pressed { background: @surface1@; }
QPushButton#nav:checked { background: @surface0@; color: @accent@; }
QPushButton#small:pressed { background: @surface2@; }
QPushButton#danger:pressed { background: @red%70@; }
QPushButton#primary[compact="true"] { padding: 6px 14px; font-size: 13px; border-radius: 9px; }
QPushButton::menu-indicator { image: none; width: 0; }

QLineEdit, QComboBox { background: @mantle@; border: 2px solid transparent; border-radius: 9px; padding: 8px 12px;
    selection-background-color: @accent@; selection-color: @on_accent@; }
QLineEdit:focus, QComboBox:focus { border-color: @accent@; }
QComboBox { padding-right: 28px; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url("@icon:arrow_down@"); width: 12px; height: 8px; }
QComboBox QAbstractItemView { background: @surface0@; color: @text@; border: none;
    selection-background-color: @surface1@; selection-color: @text@; outline: 0; padding: 4px; }
QCheckBox { spacing: 10px; background: transparent; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 5px; background: @mantle@; border: 2px solid @surface2@; }
QCheckBox::indicator:checked { background: @accent@; border-color: @accent@; image: url("@icon:check_mark@"); }
QPlainTextEdit { background: @crust@; border: none; border-radius: 10px; padding: 8px; font-size: 13px;
    selection-background-color: @accent@; selection-color: @on_accent@; }
QProgressBar { background: @mantle@; border: none; border-radius: 6px; height: 12px; text-align: center; font-size: 11px; }
QProgressBar::chunk { background: @accent@; border-radius: 6px; }

QListWidget { background: transparent; border: none; outline: 0; }
QListWidget#plist::item { background: @surface0@; border-radius: 12px; margin: 0; }
QListWidget#plist::item:hover { background: @surface1@; }
QListWidget#plist::item:selected { background: @surface1@; border: 1px solid @accent@; }
QListWidget#folders { background: @mantle@; border-radius: 10px; padding: 4px; }
QListWidget#folders::item { padding: 8px; border-radius: 8px; }
QListWidget#folders::item:selected { background: @surface1@; color: @text@; }
QWidget#rowbody { background: transparent; }
QSpinBox { background: @mantle@; border: 2px solid transparent; border-radius: 9px; padding: 6px 10px; }
QSpinBox:focus { border-color: @accent@; }
QLabel#err { color: @red@; font-size: 13px; }
QMessageBox, QInputDialog { background: @base@; }
QListWidget#grid::item { background: @surface0@; border-radius: 12px; padding: 8px; }
QListWidget#grid::item:hover { background: @surface1@; }
QListWidget#grid::item:selected { background: @surface2@; color: @text@; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @surface1@; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QMenu { background: @mantle@; border: 1px solid @surface1@; padding: 4px; }
QMenu::item { padding: 6px 20px; border-radius: 6px; }
QMenu::item:selected { background: @surface1@; }
QToolTip { background: @surface1@; color: @text@; border: none; padding: 4px 8px; }
QMainWindow { background: @crust@; }
QFrame#topbar { background: transparent; }
QFrame#side { background: @mantle@; border-radius: 14px; }
QPushButton#nav { padding: 9px 12px; font-size: 14px; }
QFrame#content { background: @base@; border-radius: 14px; }
QFrame#pill { background: @surface0@; border-radius: 12px; }
QFrame#pill[lvl="ok"] { border: 1px solid @green@; }
QFrame#pill[lvl="fail"] { border: 1px solid @red@; }
QPushButton#flat { background: transparent; padding: 6px 10px; border-radius: 8px; color: @subtext@; font-weight: 600; }
QPushButton#flat:hover { background: @surface0@; color: @text@; }
QPushButton#flat:checked { color: @accent@; }
QPushButton#cell { background: transparent; padding: 4px 8px; font-weight: 500; border-radius: 7px; text-align: left; }
QPushButton#cell:hover { background: @surface1@; }
QPushButton#star { background: transparent; padding: 2px; font-size: 18px; color: @surface2@; }
QPushButton#star:hover { background: transparent; color: @accent@; }
QPushButton#star:checked { color: @accent@; }
QTreeWidget#table { background: transparent; border: none; outline: 0; }
QTreeWidget#table::item { border-bottom: 1px solid @surface0@; }
QTreeWidget#table::item:hover { background: @mantle@; }
QTreeWidget#table::item:selected { background: @surface0@; }
QLabel#cellname { font-size: 14px; font-weight: 600; }
QFrame#panel { background: @mantle@; border-radius: 14px; }
QProgressBar { max-height: 6px; }

QTabBar#releaseTabs::tab { padding: 10px 16px; color: @subtext@; border-bottom: 2px solid @surface1@; }
QTabBar#releaseTabs::tab:selected { color: @text@; border-bottom-color: @accent@; }
QTabBar#releaseTabs::tab:hover { background: @surface0@; }

QTreeWidget#releaseTable { background: @base@; border: 0; selection-background-color: @accent@; selection-color: @on_accent@; }
QTreeWidget#releaseTable::item:selected, QListWidget#moduleChoices::item:selected,
QComboBox QAbstractItemView::item:selected { background: @accent@; color: @on_accent@; border: none; }
QTabBar#releaseTabs::tab:selected, QTabBar#releaseTabs::tab:selected:hover { background: @accent@; color: @on_accent@; }

QTreeWidget#releaseTable QPushButton#primary, QTreeWidget#releaseTable QPushButton#releaseNotes {
    padding: 0; border-radius: 6px; font-size: 13px;
}

QTreeWidget#releaseTable QPushButton#releaseNotes {
    background: transparent; color: @text@; text-decoration: underline;
}
QTreeWidget#releaseTable QPushButton#releaseNotes:hover { color: @accent@; }
QFrame#block { border-bottom: 1px solid @surface1@; }
QFrame#divider { background: @surface1@; border: none; }
QScrollArea#sectionScroll { background: transparent; border: none; }
QPlainTextEdit { background: @mantle@; border-radius: 10px; padding: 8px; }
QFrame#banner { background: @mantle@; border: 1px solid @accent@; border-radius: 10px; }
