/* ── Base ─────────────────────────────────────────────────────────────── */
QWidget#root { background-color: @base@; }

QLabel#TitleLabel {
    font-size: 26px; color: rgb(240, 240, 240); font-weight: bold;
    margin-bottom: 6px;
}

/* ── Search & filter ──────────────────────────────────────────────────── */
QLineEdit#SearchField, QComboBox#CategoryDropdown {
    border-radius: 8px; background-color: @surface0@; color: white;
    padding: 8px 12px; border: 1px solid @accent%75@;
}
QLineEdit#SearchField:focus {
    border-color: @accent@;
}
QComboBox QAbstractItemView {
    background-color: @surface0@; color: white;
    selection-background-color: @surface2@;
    border: 1px solid @accent%75@; outline: none;
}

/* ── Scroll area ──────────────────────────────────────────────────────── */
QScrollArea#ServiceList {
    background-color: @surface0%30@; border-radius: 12px;
    border: 1px solid @surface1@;
}
#ScrollContent { background-color: @surface0%30@; }

/* Скрыть полосу прокрутки по умолчанию, показать при наведении */
QScrollBar:vertical {
    background: transparent; width: 6px; margin: 0;
}
QScrollBar::handle:vertical {
    background: @surface2@; border-radius: 3px; min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: @accent@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ── Service row ──────────────────────────────────────────────────────── */
QFrame#ServiceRow {
    border-bottom: 1px solid @surface1@;
    background-color: transparent;
}
QFrame#ServiceRow:hover { background-color: @surface1@; }

QLabel#SvcDisplayName {
    color: @text@; font-weight: bold; font-size: 14px;
    background: transparent;
}
QLabel#SvcTechName {
    color: @subtext@; font-size: 11px; background: transparent;
}

/* ── Status dot ───────────────────────────────────────────────────────── */
QLabel[dotState="active"]   { color: @green@; font-size: 17px; }
QLabel[dotState="inactive"] { color: @surface2@;    font-size: 17px; }
QLabel[dotState="failed"]   { color: @red@; font-size: 17px; }

/* ── Badges ───────────────────────────────────────────────────────────── */
QLabel#Badge {
    border-radius: 4px; padding: 2px 6px;
    font-size: 11px; font-weight: bold;
}

QLabel#Badge[badgeState="running"] {
    background-color: @green/35@; color: @green@;
    border: 1px solid @green/110@;
}
QLabel#Badge[badgeState="stopped"] {
    background-color: @surface2/70@; color: @subtext@;
    border: 1px solid @subtext/70@;
}
QLabel#Badge[badgeState="failed"] {
    background-color: @red/35@; color: @red@;
    border: 1px solid @red/110@;
}
QLabel#Badge[badgeState="activating"] {
    background-color: @yellow/35@; color: @yellow@;
    border: 1px solid @yellow/110@;
}
QLabel#Badge[badgeState="enabled"] {
    background-color: @accent2/35@; color: @accent2@;
    border: 1px solid @accent2/110@;
}
QLabel#Badge[badgeState="disabled"] {
    background-color: @surface2/70@; color: @subtext@;
    border: 1px solid @subtext/70@;
}
QLabel#Badge[badgeState="static"] {
    background-color: @accent/30@; color: @accent@;
    border: 1px solid @accent_hover/90@;
}
QLabel#Badge[badgeState="masked"] {
    background-color: @red/30@; color: @red@;
    border: 1px solid @red/80@;
}

/* ── Action buttons ───────────────────────────────────────────────────── */
QPushButton#BtnAction {
    border-radius: 5px; padding: 4px 8px;
    font-size: 12px; font-weight: bold;
    border: 1px solid transparent;
}

QPushButton#BtnAction[btnAction="start"] {
    background-color: @green/28@; color: @green@;
    border-color: @green/95@;
}
QPushButton#BtnAction[btnAction="start"]:hover {
    background-color: @green/65@;
}

QPushButton#BtnAction[btnAction="stop"] {
    background-color: @yellow/28@; color: @yellow@;
    border-color: @yellow/95@;
}
QPushButton#BtnAction[btnAction="stop"]:hover {
    background-color: @yellow/65@;
}

QPushButton#BtnAction[btnAction="enable"] {
    background-color: @accent2/28@; color: @accent2@;
    border-color: @accent2/95@;
}
QPushButton#BtnAction[btnAction="enable"]:hover {
    background-color: @accent2/65@;
}

QPushButton#BtnAction[btnAction="disable"] {
    background-color: @surface2/60@; color: @subtext@;
    border-color: @subtext/75@;
}
QPushButton#BtnAction[btnAction="disable"]:hover {
    background-color: @subtext/80@;
}

QPushButton#BtnAction[btnAction="na"]:disabled {
    background-color: @surface1/40@; color: @surface2@;
    border-color: @surface2/40@;
}

QPushButton#BtnAction[btnAction="restart"] {
    background-color: @accent/28@; color: @accent@;
    border-color: @accent/95@; font-size: 14px; padding: 2px 0;
}
QPushButton#BtnAction[btnAction="restart"]:hover {
    background-color: @accent/65@;
}
QPushButton#BtnAction[btnAction="na"]:disabled {
    font-size: 14px;
}

/* ── Group headers, favorites, refresh ────────────────────────────────── */
QPushButton#GroupHeader {
    text-align: left; padding: 8px 12px; margin-top: 6px;
    background-color: @surface1%60@; color: @accent_hover@;
    border: none; border-radius: 8px;
    font-size: 14px; font-weight: bold;
}
QPushButton#GroupHeader:hover { background-color: @surface1@; }

QToolButton#StarBtn {
    /* пустая звезда — цветом второстепенного текста: surface2 в тёмных темах (Сансет) почти не виден */
    color: @subtext@; font-size: 18px; background: transparent; border: none;
}
QToolButton#StarBtn:hover { color: @yellow@; }
QToolButton#StarBtn[favorite="true"] { color: @yellow@; }

QPushButton#RefreshBtn {
    border-radius: 8px; background-color: @surface0@; color: @text@;
    padding: 8px 14px; border: 1px solid @accent%75@; font-weight: bold;
}
QPushButton#RefreshBtn:hover { border-color: @accent@; background-color: @surface1@; }
QPushButton#RefreshBtn:disabled { color: @surface2@; }

/* ── Language dropdown ────────────────────────────────────────────────
   No ::drop-down/::down-arrow rules on purpose: declaring them makes Qt
   stop drawing the native arrow. */
QComboBox#LangCombo {
    background-color: @surface1@; color: @accent_hover@;
    border: 1px solid @surface2@; border-radius: 4px;
    padding: 2px 8px; min-width: 46px;
}
QComboBox#LangCombo:hover {
    border: 1px solid @accent@;
}

/* ── Modal ────────────────────────────────────────────────────────────── */
QFrame#ModalOverlay {
    background-color: @crust/215@;
}
#ModalBox {
    background-color: @surface0@;
    border: 2px solid @accent@;
    border-radius: 12px;
}

QPushButton#ModalConfirmBtn {
    background-color: @accent%70@; color: white;
    border-radius: 7px; padding: 8px 15px; font-weight: bold;
    border: 1px solid @accent%70@;
}
QPushButton#ModalConfirmBtn:hover {
    background-color: @accent@; border-color: @accent@;
}

QPushButton#ModalCancelBtn {
    background-color: @surface2@; color: white;
    border-radius: 7px; padding: 8px 15px; font-weight: bold;
    border: 1px solid @surface2@;
}
QPushButton#ModalCancelBtn:hover {
    background-color: @subtext@; border-color: @subtext@;
}
