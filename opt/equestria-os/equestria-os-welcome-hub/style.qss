/* Базовый контейнер */
QWidget#root { background-color: @base@; }

/* Боковая панель */
QFrame#Sidebar {
    background-color: @mantle@;
    border-right: 1px solid @surface1@;
}

QLabel#SidebarTitle {
    color: @accent@;
    qproperty-alignment: 'AlignCenter';
}

/* Навигация */
QPushButton#NavBtn {
    background-color: transparent; color: @text@;
    /* Хак KDE: жесткая рамка в цвет фона, чтобы кнопка не стала системной */
    border: 1px solid @mantle@;
    padding: 10px 12px; font-size: 14px; text-align: left; border-radius: 8px;
    font-family: sans-serif;
}
QPushButton#NavBtn:hover {
    background-color: @surface0@;
    border: 1px solid @surface0@;
}
QPushButton#NavBtn[active="true"] {
    background-color: @accent@; color: @on_accent@; font-weight: bold;
    border: 1px solid @accent@;
}

/* Карточки элементов */
QPushButton#ItemCard {
    background-color: @surface0@; color: @text@;
    margin-bottom: 8px; padding: 15px; border-radius: 10px;
    /* Хак KDE + Анти-прыжок текста (резервируем 4px слева) */
    border: 1px solid @surface0@;
    border-left: 4px solid @surface0@;
    font-size: 14px; text-align: left;
    font-family: sans-serif;
}
QPushButton#ItemCard:hover {
    background-color: @surface1@;
    border: 1px solid @surface1@;
    border-left: 4px solid @accent@; /* Появляется розовая полоска */
}

/* Выпадающий список языков.
   Важно: без правил ::drop-down/::down-arrow — иначе Qt перестаёт
   рисовать нативную стрелку. */
QComboBox#LangCombo {
    background-color: @surface0@; color: @text@;
    border: 1px solid @surface1@; border-radius: 4px; padding: 4px 8px;
    font-size: 11px; font-family: sans-serif;
}
QComboBox#LangCombo:hover {
    border: 1px solid @accent@;
}
QComboBox QAbstractItemView {
    background-color: @surface0@; color: @text@;
    selection-background-color: @surface2@;
    border: 1px solid @surface1@;
    outline: none;
}

/* Безопасный чекбокс (без SVG) */
/* --- Кастомная кнопка-галочка автозапуска --- */
QPushButton#AutostartToggle {
    background-color: @mantle@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    color: transparent; /* Скрываем текст ✔, когда выключено */
    font-family: sans-serif;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 2px;
}
QPushButton#AutostartToggle:checked {
    background-color: @accent@;
    border: 1px solid @accent@;
    color: @on_accent@; /* Проявляем галочку ✔ темным цветом на розовом фоне */
}

/* Область контента */
QLabel#CategoryTitle {
    color: @accent2@; margin-bottom: 16px; font-weight: bold;
}
QScrollArea { background-color: transparent; border: none; }
QWidget#content_widget { background-color: transparent; }
