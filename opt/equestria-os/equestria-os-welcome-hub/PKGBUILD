# Maintainer: Equestria OS Team

pkgname=equestria-os-welcome-hub
pkgver=2.4.0
pkgrel=3
pkgdesc="The official Equestria OS Welcome Center and Community Portal"
arch=('any')
url="https://github.com/Lucia7Lunadottir"
license=('GPL-3.0-or-later')
depends=('equestria-qt-kit>=1.3' 'python-pyqt6' 'xdg-utils')

package() {
    local _lib="$pkgdir/opt/equestria-os/$pkgname"
    install -dm755 "$_lib"

    for f in welcome_hub.py ui_welcome.py localization.py style.qss equestria_cyrillic.ttf EquestriaOS-Logo.png; do
        install -Dm644 "$startdir/$f" "$_lib/$f"
    done
    for f in "$startdir"/locales/*.json; do
        install -Dm644 "$f" "$_lib/locales/$(basename "$f")"
    done


    # Имя изменено на equestria-os-welcome для соответствия с кодом
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/equestria-os-welcome" << 'EOF'
#!/bin/bash
cd /opt/equestria-os/equestria-os-welcome-hub/
exec python3 welcome_hub.py "$@"
EOF

    # 1. Установка обычного ярлыка в меню приложений
    install -d "$pkgdir/usr/share/applications"
    sed "s|^Exec=.*|Exec=equestria-os-welcome|" "$startdir/equestria-os-welcome.desktop" \
        > "$pkgdir/usr/share/applications/equestria-os-welcome.desktop"
    chmod 644 "$pkgdir/usr/share/applications/equestria-os-welcome.desktop"

    # 2. Установка ярлыка в глобальный автозапуск для Live-ISO
    install -d "$pkgdir/etc/xdg/autostart"
    sed "s|^Exec=.*|Exec=equestria-os-welcome|" "$startdir/equestria-os-welcome.desktop" \
        > "$pkgdir/etc/xdg/autostart/equestria-os-welcome.desktop"
    chmod 644 "$pkgdir/etc/xdg/autostart/equestria-os-welcome.desktop"
    echo "X-KDE-Autostart-after=panel" >> "$pkgdir/etc/xdg/autostart/equestria-os-welcome.desktop"

    # Установка иконки
    install -Dm644 "$startdir/EquestriaOS-Logo.png" \
        "$pkgdir/usr/share/pixmaps/equestria-os-welcome-hub.png"
}
