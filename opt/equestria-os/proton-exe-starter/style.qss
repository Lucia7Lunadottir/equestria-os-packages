QWidget {
    background-color: @crust@;
    color: @text@;
    font-size: 13px;
}
QGroupBox {
    border: 1px solid @surface1@;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 24px;
    font-weight: bold;
    color: @subtext@;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
}
QPushButton {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    padding: 6px 16px;
}
QPushButton:hover { background-color: @surface1@; }
QPushButton#btnDanger {
    background-color: @red@;
    border: 1px solid @red%85@;
}
QPushButton#btnDanger:hover { background-color: @red%85@; }
QPushButton#btnSave {
    background-color: @green@;
    border: 1px solid @green%85@;
}
QPushButton#btnSave:hover { background-color: @green%85@; }
QLineEdit {
    background-color: @mantle@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    padding: 4px;
}

/* Scrollbar */
QScrollBar:vertical {
    background: @mantle@;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: @accent%35@;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: @accent%55@; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: @mantle@;
    height: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: @accent%35@;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: @accent%55@; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: none; }

/* Выпадающие списки.
   Важно: без правил ::drop-down/::down-arrow — иначе Qt перестаёт
   рисовать нативную стрелку. */
QComboBox {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: normal;
}
QComboBox:hover { border: 1px solid @accent@; }

QComboBox#LangCombo {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    min-width: 46px;
}
QComboBox#LangCombo:hover {
    border: 1px solid @accent@;
    color: white;
}
QComboBox QAbstractItemView {
    background-color: @surface0@;
    color: @text@;
    selection-background-color: @accent%70@;
    border: 1px solid @surface1@;
    outline: none;
}

QMenu {
    background-color: @surface0%30@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 4px;
}
QMenu::item { padding: 6px 20px; }
QMenu::item:selected { background-color: @accent%70@; }
QMenu::item:disabled { color: @subtext@; }
