# Maintainer: Equestria OS
pkgname=equestria-audio-converter
pkgver=1.0
pkgrel=1
pkgdesc="Convert audio and make videos from audio (PyQt6)"
arch=('any')
license=('custom')
depends=('python-pyqt6' 'equestria-qt-kit' 'ffmpeg')
source=("equestria_audio_converter.py" "equestria-audio-converter.desktop" "i18n.json")
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/equestria_audio_converter.py" "$pkgdir/usr/bin/equestria-audio-converter"
    install -Dm644 "$srcdir/equestria-audio-converter.desktop" "$pkgdir/usr/share/applications/equestria-audio-converter.desktop"
    install -Dm644 "$srcdir/i18n.json" "$pkgdir/usr/share/equestria-audio-converter/i18n.json"
}
