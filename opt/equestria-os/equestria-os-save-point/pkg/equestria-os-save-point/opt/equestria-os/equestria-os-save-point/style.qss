/* Base background */
QWidget#root { background-color: @base@; }

QLabel#TitleLabel {
    font-size: 26px; color: rgb(240, 240, 240); font-weight: bold; margin-bottom: 10px;
}

QLabel#StatusLabel {
    color: @subtext@; font-size: 13px; padding: 2px 0;
}

QLabel#SettingsLabel {
    color: @subtext@; font-size: 13px; background: transparent;
}

QLabel#RepoSizeLabel {
    color: @subtext@; font-size: 13px; background: transparent;
}

QSpinBox#KeepLastSpin {
    background-color: @surface0@; color: white;
    border: 1px solid @accent%75@; border-radius: 6px;
    padding: 2px 6px; font-size: 13px;
}
QSpinBox#KeepLastSpin:focus {
    border: 1px solid @accent@;
}
QSpinBox#KeepLastSpin::up-button, QSpinBox#KeepLastSpin::down-button {
    background-color: @surface2@; border: none; width: 18px;
}
QSpinBox#KeepLastSpin::up-button:hover, QSpinBox#KeepLastSpin::down-button:hover {
    background-color: @accent%55@;
}

/* Snapshot list */
QScrollArea#SnapshotList {
    background-color: @surface0%30@; border-radius: 12px; border: 1px solid @surface1@;
}
#ScrollContent { background-color: @surface0%30@; }

QFrame#SnapshotRow {
    border-bottom: 1px solid @surface1@; background-color: transparent;
}
QFrame#SnapshotRow:hover {
    background-color: @surface1@;
}
QFrame#SnapshotRow[selected="true"] {
    background-color: @accent%55@; border-left: 3px solid @accent_hover@;
}

/* Thumbnail — стиль для случая с реальным изображением */
QLabel#SnapThumb {
    border-radius: 6px;
    border: 1px solid @surface2@;
}

/* =========================================
 *  ACTION BUTTONS
 * ========================================= */

QPushButton#CreateBtn {
    background-color: @accent%55@; color: white;
    border-radius: 8px; padding: 6px 22px; font-weight: bold;
    border: 1px solid @accent%75@;
    min-width: 130px;
}
QPushButton#CreateBtn:hover {
    background-color: @accent%75@; border: 1px solid @accent@;
}
QPushButton#CreateBtn:disabled {
    background-color: @surface1@; color: @subtext@;
    border: 1px solid @surface2@;
}

QPushButton#RestoreBtn {
    background-color: @green@; color: @on_green@;
    border-radius: 8px; padding: 6px 22px; font-weight: bold;
    border: 1px solid @green%65@;
    min-width: 160px;
}
QPushButton#RestoreBtn:hover {
    background-color: @green%80@; border: 1px solid @green@;
}
QPushButton#RestoreBtn:disabled {
    background-color: @surface0@; color: @surface2@;
    border: 1px solid @surface1@;
}

QPushButton#RefreshBtn {
    background-color: @surface1@; color: @text@;
    border-radius: 8px; padding: 6px 18px; font-weight: bold;
    border: 1px solid @surface2@;
    min-width: 110px;
}
QPushButton#RefreshBtn:hover {
    background-color: @surface2@; color: white;
}
QPushButton#RefreshBtn:disabled {
    background-color: @surface0@; color: @surface2@;
}

QPushButton#DeleteBtn {
    background-color: @red%45@; color: @red@;
    border-radius: 8px; padding: 6px 18px; font-weight: bold;
    border: 1px solid @red%65@;
    min-width: 110px;
}
QPushButton#DeleteBtn:hover {
    background-color: @red%65@; color: white;
    border: 1px solid @red@;
}
QPushButton#DeleteBtn:disabled {
    background-color: @surface0%45@; color: @surface2@;
    border: 1px solid @surface0@;
}

QPushButton#SettingsBtn {
    background-color: @surface1@; color: @text@;
    border-radius: 8px; font-size: 17px;
    border: 1px solid @surface2@;
}
QPushButton#SettingsBtn:hover {
    background-color: @surface2@; color: white;
}

/* =========================================
 *  SETTINGS DIALOG
 * ========================================= */
QDialog#SettingsDialog {
    background-color: @base@;
}

QLabel#SettingsDialogTitle {
    color: rgb(240, 240, 240); font-size: 18px; font-weight: bold;
    background: transparent; padding-bottom: 2px;
}

QFrame#SettingsSep {
    color: @surface2@;
    background-color: @surface2@;
    max-height: 1px;
}

QFrame#HookBox {
    background-color: @surface0@;
    border: 1px solid @surface2@;
    border-radius: 8px;
    padding: 2px;
}

QCheckBox#HookCheck {
    color: white; font-size: 14px; font-weight: bold;
    background: transparent; spacing: 8px;
}
QCheckBox#HookCheck::indicator {
    width: 18px; height: 18px;
    image: url(@icon:cb_unchecked@);
}
QCheckBox#HookCheck::indicator:hover {
    image: url(@icon:cb_unchecked_hover@);
}
QCheckBox#HookCheck::indicator:checked {
    image: url(@icon:cb_checked@);
}
QCheckBox#HookCheck::indicator:checked:hover {
    image: url(@icon:cb_checked@);
}

QLabel#HookNote {
    color: @text@; font-size: 13px; background: transparent;
    padding-top: 2px; line-height: 140%;
}

QPushButton#DeleteRepoBtn {
    background-color: @red%45@; color: @red@;
    border-radius: 5px; padding: 2px 12px; font-size: 12px;
    border: 1px solid @red%65@;
}
QPushButton#DeleteRepoBtn:hover {
    background-color: @red%65@; color: white;
    border-color: @red@;
}

QLineEdit#RepoEdit {
    background-color: @surface0@; color: @text@;
    border: 1px solid @accent%75@; border-radius: 6px;
    padding: 5px 10px; font-size: 13px;
}
QLineEdit#RepoEdit:focus {
    border: 1px solid @accent@;
}

/* =========================================
 *  PROGRESS DIALOG
 * ========================================= */
QDialog#ProgressDialog {
    background-color: @base@;
}
QLabel#ProgressTitle {
    color: white; font-size: 15px; font-weight: bold; background: transparent;
}
QPlainTextEdit#ProgressOutput {
    background-color: @mantle@;
    color: @text@;
    border: 1px solid @surface2@;
    border-radius: 6px;
    font-family: monospace;
    font-size: 12px;
    padding: 4px;
}
QProgressBar#ProgressBar {
    background-color: @surface0@;
    border: 1px solid @surface2@;
    border-radius: 4px;
    max-height: 8px;
    text-align: center;
}
QProgressBar#ProgressBar::chunk {
    background-color: @accent@;
    border-radius: 4px;
}

/* =========================================
 *  LANG DROPDOWN
 *  (no ::drop-down/::down-arrow rules on purpose: declaring them makes
 *   Qt stop drawing the native arrow)
 * ========================================= */
QComboBox#LangCombo {
    background-color: @surface0@; color: @text@;
    border: 1px solid @surface1@; border-radius: 4px; padding: 2px 8px;
    min-width: 46px;
}
QComboBox#LangCombo:hover {
    border: 1px solid @accent@; color: @text@;
}
QComboBox#LangCombo QAbstractItemView {
    background-color: @surface0@; color: @text@;
    border: 1px solid @surface1@;
    selection-background-color: @surface2@;
    outline: none;
}

/* =========================================
 *  MODAL OVERLAY & BOX
 * ========================================= */
QFrame#ModalOverlay {
    background-color: @crust/220@;
}
#ModalBox {
    background-color: @surface0%55@;
    border: 2px solid @accent%80@;
    border-radius: 12px;
}

QPushButton#ModalOkBtn {
    background-color: @green@; color: @on_green@;
    border-radius: 8px; padding: 8px 15px; font-weight: bold;
    border: 1px solid @green%65@;
}
QPushButton#ModalOkBtn:hover {
    background-color: @green%80@; border: 1px solid @green@;
}

QPushButton#ModalCancelBtn {
    background-color: @surface2@; color: white;
    border-radius: 8px; padding: 8px 15px; font-weight: bold;
    border: 1px solid @surface2@;
}
QPushButton#ModalCancelBtn:hover {
    background-color: @surface2@; border: 1px solid @surface2@;
}
