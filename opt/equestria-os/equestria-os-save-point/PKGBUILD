# Maintainer: Equestria OS Team

pkgname=equestria-os-save-point
pkgver=1.6.0
pkgrel=1
# Только Btrfs: поддержка ext4 и других ФС (restic/timeshift) удалена из-за нестабильности бэкапов
pkgdesc="Equestria OS Save Point — Btrfs system snapshot manager (Btrfs only)"
arch=('any')
url="https://github.com/Lucia7Lunadottir"
license=('GPL')
depends=('equestria-qt-kit>=1.1' 'btrfs-progs' 'python-pyqt6')
install='equestria-os-save-point.install'
optdepends=(
    'spectacle: desktop screenshots on KDE'
    'grim: desktop screenshots on Wayland'
    'scrot: desktop screenshots on X11'
    'ffmpeg: screenshot resize/WebP conversion'
    'imagemagick: screenshot resize/WebP conversion (alternative)'
)

package() {
    # 1. Создаем целевую директорию приложения в /opt
    local _optdir="$pkgdir//opt/equestria-os/equestria-os-save-point"
    install -d "$_optdir"

    # 2. Копируем туда все исходники и ресурсы прямо из $startdir
    install -m755 "$startdir/main.py" "$_optdir/main.py"
    install -m644 "$startdir/backend.py" "$_optdir/backend.py"
    install -m644 "$startdir/hooks.py" "$_optdir/hooks.py"
    install -m644 "$startdir/screenshot.py" "$_optdir/screenshot.py"
    install -m644 "$startdir/ui_pkg.py" "$_optdir/ui_pkg.py"
    install -m644 "$startdir/utils.py" "$_optdir/utils.py"
    install -m644 "$startdir/style.qss" "$_optdir/style.qss"
    install -m644 "$startdir/equestria_cyrillic.ttf" "$_optdir/equestria_cyrillic.ttf"
    install -m644 "$startdir/equestria-os-save-point.png" "$_optdir/equestria-os-save-point.png"

    install -m755 "$startdir/restore-system.py" "$_optdir/restore-system.py"
    install -m755 "$startdir/rollback.py" "$_optdir/rollback.py"
    install -m644 "$startdir/COMMANDS.md" "$_optdir/COMMANDS.md"
    install -m755 "$startdir/pacman-snapshot.sh" "$_optdir/pacman-snapshot.sh"
    install -m755 "$startdir/flatpak-hook.sh" "$_optdir/flatpak-hook.sh"
    # Копия хука — из неё настройки приложения включают хук обратно
    install -m644 "$startdir/equestria-save-point.hook" "$_optdir/equestria-save-point.hook"
    install -m755 "$startdir/start.sh" "$_optdir/start.sh"

    # Копируем папки локализации и иконок
    cp -a "$startdir/icons" "$_optdir/"
    cp -a "$startdir/locales" "$_optdir/"

    # 3. Создаем бинарник-обертку в /usr/bin для запуска GUI
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/equestria-os-save-point" << 'EOF'
#!/bin/bash
cd //opt/equestria-os/equestria-os-save-point/
exec python3 main.py "$@"
EOF

    # 4. Настраиваем и переносим ярлык приложения (.desktop)
    install -d "$pkgdir/usr/share/applications"
    sed "s|^Exec=.*|Exec=equestria-os-save-point|" \
        "$startdir/equestria-os-save-point.desktop" \
        > "$pkgdir/usr/share/applications/equestria-os-save-point.desktop"
    chmod 644 "$pkgdir/usr/share/applications/equestria-os-save-point.desktop"

    # 5. Кладим иконку в системную папку для DE
    install -Dm644 "$startdir/equestria-os-save-point.png" \
        "$pkgdir/usr/share/pixmaps/equestria-os-save-point.png"

    # 6. Устанавливаем системные хуки pacman и flatpak туда, где их ждет ОС
    install -Dm644 "$startdir/equestria-save-point.hook" "$pkgdir/etc/pacman.d/hooks/equestria-save-point.hook"
    install -Dm644 "$startdir/flatpak-hook.sh" "$pkgdir/etc/profile.d/60-equestria-save-point.sh"

    # 7. Делаем симлинк для консольной утилиты восстановления
    install -d "$pkgdir/usr/bin"
    ln -s "//opt/equestria-os/equestria-os-save-point/restore-system.py" "$pkgdir/usr/bin/restore-system"

    # 8. Ежедневный снимок (systemd-таймер)
    install -d "$pkgdir/usr/lib/systemd/system/"
    install -Dm644 "$startdir/equestria-save-point-daily.timer" "$pkgdir/usr/lib/systemd/system/equestria-save-point-daily.timer"
    install -Dm644 "$startdir/equestria-save-point-daily.service" "$pkgdir/usr/lib/systemd/system/equestria-save-point-daily.service"

    # 9. Автооткат, только когда система не загружается (с 1.6.0): 3 загрузки подряд не дошли
    #    до экрана входа → откат к точке после последней удачной загрузки (rollback.py).
    #    Прежний автооткат (до 1.5.0-3) срабатывал на любой сбой graphical.target и откатывал
    #    к самой новой точке — однажды это сломало пакеты KDE.
    install -Dm644 "$startdir/equestria-boot-guard.service" "$pkgdir/usr/lib/systemd/system/equestria-boot-guard.service"
    install -Dm644 "$startdir/equestria-boot-ok.service" "$pkgdir/usr/lib/systemd/system/equestria-boot-ok.service"
    install -Dm644 "$startdir/equestria-boot-ok.timer" "$pkgdir/usr/lib/systemd/system/equestria-boot-ok.timer"
    install -Dm644 "$startdir/equestria-save-point-notice.desktop" "$pkgdir/etc/xdg/autostart/equestria-save-point-notice.desktop"
}
