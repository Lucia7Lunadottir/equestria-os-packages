QWidget#root {
    background-color: @crust@;
}

/* Make stacked widget pages transparent so #root background shows through */
QStackedWidget {
    background: transparent;
}

QLabel[cssClass="title"] {
    font-family: "Equestria_Cyrillic", "Noto Sans", sans-serif;
    font-size: 24px;
    color: @text@;
    font-weight: bold;
    margin-bottom: 4px;
}

QLabel[cssClass="subtitle"] {
    font-family: "Equestria_Cyrillic", "Noto Sans", sans-serif;
    font-size: 13px;
    color: @subtext@;
    margin-bottom: 20px;
}

/* Character Buttons & Text */
QLabel[cssClass="char-name"] {
    font-size: 12px;
    font-weight: bold;
    color: rgb(230, 220, 255);
}

/* Status Bar & Panels */
QWidget[cssClass="status-bar"] {
    background-color: @mantle@;
    border-radius: 12px;
}

QLabel[cssClass="status-label"] {
    font-size: 13px;
    color: @subtext@;
}

/* Action Buttons */
QPushButton[cssClass="action-btn"] {
    background-color: @accent%70@;
    border: 1px solid @accent@;
    border-radius: 8px;
    color: white;
    padding: 6px 16px;
    font-size: 12px;
}

QPushButton[cssClass="action-btn"]:hover {
    background-color: @accent@;
}

/* Panel Theme Buttons */
QPushButton[cssClass="theme-btn"] {
    background-color: transparent;
    color: @subtext@;
    border: 1px solid @surface1@;
    border-radius: 6px;
    padding: 4px 14px;
    font-size: 12px;
}

QPushButton[cssClass="theme-btn"]:hover {
    background-color: @surface0@;
    color: @text@;
}

QPushButton[cssClass="theme-btn"][active="true"] {
    background-color: @accent%70@;
    color: white;
    border: 1px solid @accent@;
    font-weight: bold;
}

/* Language Dropdown.
   No ::drop-down/::down-arrow rules here on purpose: declaring them makes
   Qt stop drawing the native arrow. */
QComboBox#LangCombo {
    background-color: @surface0@;
    color: @text@;
    border: 1px solid @surface1@;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    min-width: 46px;
}

QComboBox#LangCombo:hover {
    border: 1px solid @accent@;
}

/* Scroll Area */
QScrollArea {
    background: transparent;
    border: none;
}

/* Preset Cards */
QPushButton[cssClass="preset-card"] {
    background-color: @surface0%45@;
    border-radius: 16px;
    border: 2px solid @surface1@;
    padding: 8px;
}

QPushButton[cssClass="preset-card"]:hover {
    background-color: @surface0@;
    border: 2px solid @surface2@;
}

QPushButton[cssClass="preset-card"][active="true"] {
    border: 3px solid @accent@;
    background-color: @surface0@;
}

/* Color Swatch Button */
QPushButton#ColorSwatchBtn {
    border-radius: 4px;
    border: 2px solid @surface1@;
    min-width: 40px;
    min-height: 24px;
}

QPushButton#ColorSwatchBtn:hover {
    border: 2px solid @accent_hover@;
}

/* Opacity Slider */
QSlider::groove:horizontal {
    background: @surface0@;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: @accent@;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: @accent@;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

/* Layout Description Label */
QLabel[cssClass="layout-desc"] {
    font-size: 11px;
    color: @subtext@;
}

/* Editor Fields */
QLineEdit#EditorField {
    background-color: @crust@;
    border: 1px solid @surface2@;
    border-radius: 6px;
    color: @text@;
    padding: 5px 8px;
    font-size: 13px;
}

QLineEdit#EditorField:focus {
    border: 1px solid @accent@;
}

QLineEdit#EditorField[readOnly="true"] {
    color: @subtext@;
}

/* Editor SpinBox */
QSpinBox#EditorSpinBox {
    background-color: @crust@;
    border: 1px solid @surface2@;
    border-radius: 6px;
    color: @text@;
    padding: 4px 6px;
    font-size: 13px;
}

QSpinBox#EditorSpinBox:focus {
    border: 1px solid @accent@;
}

QSpinBox#EditorSpinBox::up-button, QSpinBox#EditorSpinBox::down-button {
    background: @surface1@;
    border: none;
    border-radius: 3px;
    width: 16px;
}

QSpinBox#EditorSpinBox::up-button:hover, QSpinBox#EditorSpinBox::down-button:hover {
    background: @accent%70@;
}

/* Browse / small utility button */
QPushButton#BrowseBtn {
    background-color: @surface1@;
    border: 1px solid @surface2@;
    border-radius: 4px;
    color: @text@;
    font-size: 13px;
    padding: 0;
}

QPushButton#BrowseBtn:hover {
    background-color: @accent%55@;
}

/* Editor section divider */
QFrame#EditorDivider {
    color: @surface2@;
    margin: 4px 0;
}

/* Capture status label */
QLabel[cssClass="capture-status"] {
    font-size: 12px;
    color: @subtext@;
    font-style: italic;
}

/* ─── Scrollbar ──────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: @mantle@;
    width: 7px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: @accent%35@;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: @accent@;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: @mantle@;
    height: 7px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: @accent%35@;
    border-radius: 3px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: @accent@;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ─── Panel Row Widget ───────────────────────────────────────────── */
QFrame#PanelRow {
    background-color: @base@;
    border: 1px solid @surface2@;
    border-radius: 8px;
}

QFrame#PanelRow QLabel {
    color: @subtext@;
    font-size: 12px;
}

QFrame#PanelRow QCheckBox {
    color: @text@;
    font-size: 12px;
    spacing: 5px;
}

QFrame#PanelRow QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @subtext@;
    border-radius: 3px;
    background-color: @mantle@;
}

QFrame#PanelRow QCheckBox::indicator:hover {
    border: 1px solid @accent@;
}

QFrame#PanelRow QCheckBox::indicator:checked {
    background-color: @accent@;
    border: 1px solid @accent@;
}

QFrame#PanelRow QComboBox {
    background-color: @mantle@;
    border: 1px solid @surface2@;
    border-radius: 5px;
    color: @text@;
    padding: 3px 6px;
    font-size: 12px;
    min-height: 22px;
}

QFrame#PanelRow QComboBox:hover {
    border: 1px solid @accent%75@;
}

QFrame#PanelRow QComboBox::drop-down {
    background: @surface1@;
    border-left: 1px solid @surface2@;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    width: 18px;
}

QFrame#PanelRow QComboBox QAbstractItemView,
QFrame#PanelRow QComboBox QListView {
    background-color: @base@;
    color: @text@;
    border: 1px solid @accent%35@;
    selection-background-color: @accent%70@;
    selection-color: white;
    outline: none;
}

QFrame#PanelRow QSpinBox {
    background-color: @mantle@;
    border: 2px solid @subtext@;
    border-radius: 5px;
    color: @text@;
    padding: 5px 8px;
    font-size: 14px;
    min-height: 32px;
}

QFrame#PanelRow QSpinBox:hover {
    border-color: @accent@;
}

QFrame#PanelRow QSpinBox::up-button,
QFrame#PanelRow QSpinBox::down-button {
    background-color: @surface1@;
    border-left: 2px solid @subtext@;
    width: 22px;
}

QFrame#PanelRow QSpinBox::up-button:hover,
QFrame#PanelRow QSpinBox::down-button:hover {
    background-color: @accent%70@;
}

QFrame#PanelRow QSpinBox::up-arrow {
    width: 0px;
    height: 0px;
    border-left: 5px solid @surface1@;
    border-right: 5px solid @surface1@;
    border-bottom: 5px solid @accent_hover@;
}

QFrame#PanelRow QSpinBox::up-arrow:hover {
    border-bottom-color: white;
}

QFrame#PanelRow QSpinBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 5px solid @surface1@;
    border-right: 5px solid @surface1@;
    border-top: 5px solid @accent_hover@;
}

QFrame#PanelRow QSpinBox::down-arrow:hover {
    border-top-color: white;
}

QPushButton#PanelMoveBtn {
    background-color: @surface1@;
    border: 1px solid @surface2@;
    border-radius: 4px;
    color: @text@;
    padding: 0;
}

QPushButton#PanelMoveBtn:hover {
    background-color: @accent%35@;
    color: white;
}

QPushButton#PanelRemoveBtn {
    background-color: @accent2%25@;
    border: 1px solid @accent2%45@;
    border-radius: 4px;
    color: @red@;
    font-size: 12px;
    padding: 0;
}

QPushButton#PanelRemoveBtn:hover {
    background-color: @red%45@;
    color: @red@;
}

QPushButton#PanelMoveBtn,
QPushButton#PanelRemoveBtn,
QPushButton#BrowseBtn {
}

/* ─── QComboBox dropdown (global — prevents transparent popups) ─── */
QComboBox QAbstractItemView,
QComboBox QListView {
    background-color: @base@; /* Жестко задаем фон окна списка */
    color: @text@;
    border: 1px solid @accent%35@;
    selection-background-color: @accent%70@;
    selection-color: white;
    outline: none;
    padding: 2px;
}

/* Явно задаем фон для самих элементов списка, чтобы избежать прозрачности */
QComboBox QAbstractItemView::item,
QComboBox QListView::item {
    background-color: @base@;
    color: @text@;
    padding: 4px 8px;
    min-height: 22px;
}

/* Стили при наведении и выборе */
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected,
QComboBox QListView::item:hover,
QComboBox QListView::item:selected {
    background-color: @accent%70@;
    color: white;
}
