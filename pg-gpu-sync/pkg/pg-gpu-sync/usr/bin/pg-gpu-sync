#!/bin/bash

# ============================================================
#  PG GPU Sync — Equestria OS
#  Automated NVIDIA driver manager for Arch-based systems.
#
#  Compatible with: Equestria OS, pure Arch Linux.
#
#  Modes:
#    Interactive  — asks for confirmation (default)
#    --auto       — fully silent, for OS installer / live image
#    --test       — dry run, nothing is changed
# ============================================================

# ── Colour output ─────────────────────────────────────────────
_RED='\033[0;31m'
_YEL='\033[1;33m'
_GRN='\033[0;32m'
_CYN='\033[0;36m'
_RST='\033[0m'

Info()   { echo -e "${_GRN}[pg-gpu-sync]${_RST} $*"; }
Warn()   { echo -e "${_YEL}[WARNING]${_RST}     $*" >&2; }
DIE()    { echo -e "${_RED}[ERROR]${_RST}       $*" >&2; exit 1; }
Note()   { echo -e "${_CYN}[NOTE]${_RST}        $*"; }
Header() { echo -e "\n${_CYN}══════════════════════════════════════${_RST}\n  $*\n${_CYN}══════════════════════════════════════${_RST}"; }

# ── State file (для обнаружения смены GPU) ────────────────────
STATE_FILE=/var/lib/pg-gpu-sync/gpu-family

# ── Offline driver cache ───────────────────────────────────────
DRIVER_CACHE_DIR=/usr/share/pg-gpu-sync/drivers

GpuChanged() {
    [ ! -f "$STATE_FILE" ] && return 0
    [ "$(cat "$STATE_FILE")" != "$GPU_FAMILY" ]
}

SaveGpuState() {
    [ "$DRY_RUN" = yes ] && return
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s\n' "$GPU_FAMILY" > "$STATE_FILE"
}

# ── Helper functions ──────────────────────────────────────────

IsInstalled() { pacman -Qq "$1" &>/dev/null; }

HasRepo() { grep -q "^\[$1\]" /etc/pacman.conf; }

PkgAvailableInRepos() { pacman -Si "$1" &>/dev/null; }

# ── GPU Detection ─────────────────────────────────────────────

DetectGPU() {
    GPU_RAW=$(lspci -d 10de::0300 2>/dev/null | head -n 1)
    [ -z "$GPU_RAW" ] && GPU_RAW=$(lspci -d 10de::0302 2>/dev/null | head -n 1)
    [ -z "$GPU_RAW" ] && GPU_RAW=$(lspci | grep -i "NVIDIA" | grep -iE "VGA|3D|Display" | head -n 1)

    GPU_FAMILY=$(echo "$GPU_RAW" | sed -E 's|.*NVIDIA Corporation ([A-Z]{2})[0-9A-Z]+ .*|\1|')
    GPU_NAME=$(echo   "$GPU_RAW" | sed -E 's|.*NVIDIA Corporation ([^[]+).*|\1|' | xargs)

    if [ -z "$GPU_FAMILY" ] || [ ${#GPU_FAMILY} -ne 2 ]; then
        GPU_FAMILY=$(echo "$GPU_RAW" | grep -oP '(?<=NVIDIA Corporation )[A-Z]{2}')
    fi
}

DetectOptimus() {
    OPTIMUS=no
    local igpu
    igpu=$(lspci | grep -iE "VGA|3D|Display" | grep -iv "NVIDIA")
    [ -n "$igpu" ] && OPTIMUS=yes
}

FamilyName() {
    case "$1" in
        TU) echo "Turing (RTX 20xx / GTX 16xx)" ;;
        GA) echo "Ampere (RTX 30xx)" ;;
        AD) echo "Ada Lovelace (RTX 40xx)" ;;
        GB) echo "Blackwell (RTX 50xx)" ;;
        GN) echo "Next-gen" ;;
        GV) echo "Volta (Titan V / Quadro)" ;;
        GM) echo "Maxwell (GTX 750 / 900 / 9xxM laptops)" ;;
        GP) echo "Pascal (GTX 10xx / 10xxM laptops)" ;;
        GK) echo "Kepler (GTX 600/700 / GT 7xxM laptops)" ;;
        GF) echo "Fermi (GT 400/500 / GT 5xxM laptops)" ;;
        *)  echo "Unknown / very old (nouveau recommended)" ;;
    esac
}

# ── Driver Selection ──────────────────────────────────────────
#
#  nvidia-open-dkms            = open kernel modules (GSP firmware)
#                                Turing (TU) and newer ONLY
#
#  equestria-nvidia-580xx-dkms = proprietary closed-source kernel modules (v580)
#  equestria-nvidia-580xx-utils = userspace libraries (v580)
#                                Last driver branch supporting Maxwell / Pascal / Volta.
#                                NVIDIA 590+ dropped these GPU architectures.
#                                nvidia-open-dkms causes kernel panics on them.

SelectDriver() {
    DRIVER_TYPE=""
    DRIVER_PKG=""
    DRIVER_UTILS_PKG="nvidia-utils"
    DRIVER_32BIT_UTILS_PKG="lib32-nvidia-utils"
    GPU_GENERATION=""

    if [ "$MODE" = "nouveau" ]; then
        DRIVER_TYPE="nouveau"
        return
    fi

    case "$GPU_FAMILY" in
        TU*|GA*|AD*|GB*|GN*)
            # Turing and newer → open-source kernel modules (GSP firmware)
            DRIVER_TYPE="open"
            DRIVER_PKG="nvidia-open-dkms"
            DRIVER_UTILS_PKG="nvidia-utils"
            DRIVER_32BIT_UTILS_PKG="lib32-nvidia-utils"
            GPU_GENERATION="modern"
            ;;
        GM*|GP*|GV*)
            # Maxwell / Pascal / Volta → proprietary 580.x (last branch with support).
            # NVIDIA 590+ dropped these architectures entirely.
            # nvidia-open-dkms causes kernel panics on pre-Turing GPUs.
            GPU_GENERATION="legacy"
            if PkgAvailableInRepos "equestria-nvidia-580xx-dkms" || [ -n "$(FindCachedPkg equestria-nvidia-580xx-dkms)" ]; then
                DRIVER_TYPE="proprietary"
                DRIVER_PKG="equestria-nvidia-580xx-dkms"
                DRIVER_UTILS_PKG="equestria-nvidia-580xx-utils"
                DRIVER_32BIT_UTILS_PKG="lib32-equestria-nvidia-580xx-utils"
            elif PkgAvailableInRepos "equestria-nvidia-dkms" || [ -n "$(FindCachedPkg equestria-nvidia-dkms)" ]; then
                # Legacy fallback: self-updating package (downloads .run at install time)
                DRIVER_TYPE="proprietary"
                DRIVER_PKG="equestria-nvidia-dkms"
                DRIVER_UTILS_PKG="nvidia-utils"
                DRIVER_32BIT_UTILS_PKG="lib32-nvidia-utils"
            else
                Warn "No proprietary NVIDIA driver available for $(FamilyName "$GPU_FAMILY") GPU."
                Warn "  NVIDIA 590+ dropped support for this architecture."
                Warn "  nvidia-open-dkms causes kernel panics on pre-Turing GPUs."
                Warn "  Falling back to nouveau. Gaming performance will be limited."
                Warn "  For full support, place equestria-nvidia-580xx-dkms pkg in $DRIVER_CACHE_DIR/"
                DRIVER_TYPE="nouveau"
            fi
            ;;
        GK*)
            DRIVER_TYPE="proprietary"
            DRIVER_PKG="nvidia-470xx-dkms"
            DRIVER_UTILS_PKG="nvidia-470xx-utils"
            GPU_GENERATION="kepler"
            ;;
        GF*)
            DRIVER_TYPE="proprietary"
            DRIVER_PKG="nvidia-390xx-dkms"
            DRIVER_UTILS_PKG="nvidia-390xx-utils"
            GPU_GENERATION="fermi"
            ;;
        "")
            if [ "$FORCE" = yes ]; then
                Warn "No NVIDIA GPU detected, proceeding because --force is set."
                DRIVER_TYPE="open"
                DRIVER_PKG="nvidia-open-dkms"
                DRIVER_UTILS_PKG="nvidia-utils"
            elif [ "$AUTO" = yes ]; then
                Note "No NVIDIA GPU detected — will clean up NVIDIA packages."
                DRIVER_TYPE="skip"
            else
                DIE "No NVIDIA GPU detected.\n       Use --force to override, or --nouveau for the nouveau driver."
            fi
            ;;
        *)
            DRIVER_TYPE="nouveau"
            ;;
    esac

    if [ "$NO_DKMS" = yes ]; then
        case "$DRIVER_PKG" in
            nvidia-open-dkms)
                DRIVER_PKG="nvidia-open"
                Note "--no-dkms: using 'nvidia-open' instead of 'nvidia-open-dkms'."
                ;;
            equestria-nvidia-580xx-dkms|equestria-nvidia-dkms|nvidia-dkms)
                Note "--no-dkms: ignored for $DRIVER_PKG (DKMS-only package)."
                ;;
            *)
                Note "--no-dkms: ignored for $DRIVER_PKG (DKMS-only package)."
                ;;
        esac
    fi
}

# ── Kernel Headers ────────────────────────────────────────────

CollectKernelHeaders() {
    HEADERS_TO_INSTALL=()
    [ "$NO_DKMS" = yes ] && return

    local kernels=(linux linux-lts linux-zen linux-hardened linux-rt linux-rt-lts)
    for k in "${kernels[@]}"; do
        if IsInstalled "$k" && ! IsInstalled "${k}-headers"; then
            HEADERS_TO_INSTALL+=("${k}-headers")
            Info "Will install ${k}-headers (DKMS requirement)"
        fi
    done
}

# ── Offline cache lookup ──────────────────────────────────────

FindCachedPkg() {
    local name="$1"
    [ -d "$DRIVER_CACHE_DIR" ] || return
    ls -t "$DRIVER_CACHE_DIR/${name}-"*.pkg.tar.zst 2>/dev/null | head -n 1
}

# ── Package Lists ─────────────────────────────────────────────

BuildPackageLists() {
    INSTALL=()
    REMOVE=()

    if [ "$DRIVER_TYPE" = "nouveau" ]; then
        INSTALL+=(vulkan-nouveau)
        HasRepo multilib && [ "$BIT32" = yes ] && INSTALL+=(lib32-vulkan-nouveau)

        local rm_list=(
            nvidia-open-dkms nvidia-open nvidia-open-lts
            nvidia-dkms equestria-nvidia-dkms nvidia nvidia-lts nvidia-utils
            equestria-nvidia-580xx-dkms equestria-nvidia-580xx-utils lib32-equestria-nvidia-580xx-utils
            nvidia-470xx-dkms nvidia-470xx-utils
            nvidia-390xx-dkms nvidia-390xx-utils
            nvidia-settings
        )
        for p in "${rm_list[@]}"; do
            IsInstalled "$p" && REMOVE+=("$p")
        done

    else
        INSTALL+=("$DRIVER_PKG" "$DRIVER_UTILS_PKG")

        if [ "$SETTINGS_PKG" = yes ] && [ "$GPU_GENERATION" != "fermi" ] && [ "$GPU_GENERATION" != "kepler" ]; then
            INSTALL+=(nvidia-settings)
        fi

        if HasRepo multilib && [ "$BIT32" = yes ]; then
            case "$GPU_GENERATION" in
                modern|legacy) INSTALL+=("$DRIVER_32BIT_UTILS_PKG") ;;
                *) Note "32-bit libs not available for $DRIVER_PKG — skipping." ;;
            esac
        fi

        if [ "$OPTIMUS" = yes ]; then
            IsInstalled nvidia-prime || INSTALL+=(nvidia-prime)
        fi

        if [ "$NO_DKMS" = no ]; then
            IsInstalled dkms || INSTALL+=(dkms)
            INSTALL+=("${HEADERS_TO_INSTALL[@]}")
        fi

        # Remove conflicting drivers.
        # All branches are mutually exclusive: only one set of kernel modules
        # and one nvidia-utils version can be active at a time.
        local rm_list=(xf86-video-nouveau vulkan-nouveau lib32-vulkan-nouveau)
        case "$DRIVER_PKG" in
            nvidia-open-dkms|nvidia-open|nvidia-open-lts)
                # Modern (Turing+) — remove all legacy
                rm_list+=(nvidia-dkms equestria-nvidia-dkms nvidia nvidia-lts
                          equestria-nvidia-580xx-dkms equestria-nvidia-580xx-utils lib32-equestria-nvidia-580xx-utils
                          nvidia-470xx-dkms nvidia-470xx-utils
                          nvidia-390xx-dkms nvidia-390xx-utils)
                ;;
            equestria-nvidia-580xx-dkms)
                # Legacy 580xx (Pascal/Maxwell/Volta) — remove modern and other legacy.
                # Do NOT add nvidia-utils / lib32-nvidia-utils here: they have
                # dependents, so pacman -Rns would fail and block the whole
                # REMOVE transaction.  pacman replaces them automatically when
                # installing equestria-nvidia-580xx-utils (conflicts/provides).
                rm_list+=(nvidia-open-dkms nvidia-open nvidia-open-lts
                          nvidia-dkms equestria-nvidia-dkms nvidia nvidia-lts
                          nvidia-470xx-dkms nvidia-470xx-utils
                          nvidia-390xx-dkms nvidia-390xx-utils)
                ;;
            equestria-nvidia-dkms)
                # Old self-updating package (fallback)
                rm_list+=(nvidia-open-dkms nvidia-open nvidia-open-lts
                          equestria-nvidia-580xx-dkms equestria-nvidia-580xx-utils lib32-equestria-nvidia-580xx-utils
                          nvidia-dkms nvidia nvidia-lts
                          nvidia-470xx-dkms nvidia-470xx-utils
                          nvidia-390xx-dkms nvidia-390xx-utils)
                ;;
            nvidia-470xx-dkms)
                # nvidia-utils removed via conflicts/provides by nvidia-470xx-utils
                rm_list+=(nvidia-open-dkms nvidia-open nvidia-open-lts
                          nvidia-dkms equestria-nvidia-dkms nvidia nvidia-lts
                          equestria-nvidia-580xx-dkms equestria-nvidia-580xx-utils lib32-equestria-nvidia-580xx-utils
                          nvidia-390xx-dkms nvidia-390xx-utils)
                ;;
            nvidia-390xx-dkms)
                # nvidia-utils removed via conflicts/provides by nvidia-390xx-utils
                rm_list+=(nvidia-open-dkms nvidia-open nvidia-open-lts
                          nvidia-dkms equestria-nvidia-dkms nvidia nvidia-lts
                          equestria-nvidia-580xx-dkms equestria-nvidia-580xx-utils lib32-equestria-nvidia-580xx-utils
                          nvidia-470xx-dkms nvidia-470xx-utils)
                ;;
        esac
        for p in "${rm_list[@]}"; do
            IsInstalled "$p" && REMOVE+=("$p")
        done
    fi

    # Remove already-installed from INSTALL list
    local filtered=()
    for p in "${INSTALL[@]}"; do
        [ -z "$p" ] && continue
        IsInstalled "$p" || filtered+=("$p")
    done
    INSTALL=("${filtered[@]}")

    readarray -t REMOVE < <(printf "%s\n" "${REMOVE[@]}" | sort -u)
}

# ── Nouveau Blacklist ─────────────────────────────────────────

ConfigureNouveauBlacklist() {
    local conf=/etc/modprobe.d/blacklist-nouveau.conf

    if [ "$DRIVER_TYPE" = "nouveau" ]; then
        if [ -f "$conf" ]; then
            Info "Removing nouveau blacklist (using nouveau driver)"
            [ "$DRY_RUN" = no ] && rm -f "$conf"
        fi
        return
    fi

    if [ -f "$conf" ] && grep -q "blacklist nouveau" "$conf"; then
        Info "Nouveau blacklist already set in $conf"
        return
    fi

    Info "Writing nouveau blacklist → $conf"
    if [ "$DRY_RUN" = no ]; then
        printf 'blacklist nouveau\noptions nouveau modeset=0\n' > "$conf"
    else
        Note "[DRY RUN] Would write nouveau blacklist → $conf"
    fi
}

# ── Wayland DRM Modeset ───────────────────────────────────────

ConfigureWayland() {
    [ "$DRIVER_TYPE" = "nouveau" ] && return

    local conf=/etc/modprobe.d/nvidia.conf

    Info "Writing NVIDIA modprobe config → $conf"
    if [ "$DRY_RUN" = no ]; then
        {
            if [ "$GPU_GENERATION" = "modern" ] || [ "$GPU_GENERATION" = "legacy" ]; then
                printf 'options nvidia_drm modeset=1 fbdev=1\n'
            else
                printf 'options nvidia_drm modeset=1\n'
            fi

            if [ "$GPU_GENERATION" = "modern" ] || [ "$GPU_GENERATION" = "legacy" ] || [ "$GPU_GENERATION" = "kepler" ]; then
                printf 'options nvidia NVreg_PreserveVideoMemoryAllocations=1\n'
            fi

            if [ "$GPU_GENERATION" != "modern" ]; then
                printf 'options nvidia NVreg_EnableGpuFirmware=0\n'
            fi
        } > "$conf"
    else
        Note "[DRY RUN] Would write nvidia modprobe options → $conf  (generation: $GPU_GENERATION)"
    fi

    local envconf=/etc/environment.d/99-nvidia-wayland.conf
    if [ -f "$envconf" ]; then
        Info "NVIDIA Wayland environment already set in $envconf"
        return
    fi

    Info "Writing NVIDIA Wayland environment → $envconf"
    if [ "$DRY_RUN" = no ]; then
        mkdir -p /etc/environment.d
        cat > "$envconf" <<'ENVEOF'
# NVIDIA Wayland support — written by pg-gpu-sync
GBM_BACKEND=nvidia-drm
__GLX_VENDOR_LIBRARY_NAME=nvidia
ENVEOF
    else
        Note "[DRY RUN] Would write NVIDIA Wayland env → $envconf"
    fi
}

# ── KDE / KWin Compositor Configuration ──────────────────────

ConfigureKwinCompositor() {
    [ "$DRIVER_TYPE" = "nouveau" ] && return

    local kwinconf=/etc/xdg/kwinrc

    if [ -f "$kwinconf" ] && grep -q "GLCore" "$kwinconf"; then
        Info "KWin compositor config already present in $kwinconf"
        return
    fi

    Info "Writing KWin compositor defaults → $kwinconf"
    if [ "$DRY_RUN" = no ]; then
        mkdir -p /etc/xdg

        # Remove existing [Compositing] section to avoid duplicates
        if [ -f "$kwinconf" ]; then
            sed -i '/^\[Compositing\]/,/^\[/{/^\[Compositing\]/d;/^\[/!d}' "$kwinconf"
        fi

        cat >> "$kwinconf" <<'KWINEOF'

[Compositing]
Backend=OpenGL
GLCore=true
GLPreferBufferSwap=e
OpenGLIsUnsafe=false
AnimationSpeed=3
Enabled=true
KWINEOF
    else
        Note "[DRY RUN] Would write KWin compositor config → $kwinconf"
    fi

    local kwinenv=/etc/environment.d/99-kwin-nvidia.conf
    if [ ! -f "$kwinenv" ]; then
        Info "Writing KWin NVIDIA environment → $kwinenv"
        if [ "$DRY_RUN" = no ]; then
            mkdir -p /etc/environment.d
            cat > "$kwinenv" <<'KWENVEOF'
# KWin: EGL vendor for NVIDIA
__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
KWENVEOF
        else
            Note "[DRY RUN] Would write KWin env → $kwinenv"
        fi
    fi
}

# ── NVIDIA Suspend/Resume Services ───────────────────────────

EnableNvidiaSleepServices() {
    [ "$DRIVER_TYPE" = "nouveau" ] && return
    [ "$GPU_GENERATION" = "kepler" ] && return
    [ "$GPU_GENERATION" = "fermi"  ] && return

    [ "$DRY_RUN" = yes ] && { Note "[DRY RUN] Would enable nvidia suspend/resume/hibernate services"; return; }

    local services=(nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service)
    for svc in "${services[@]}"; do
        if systemctl list-unit-files "$svc" &>/dev/null; then
            systemctl enable "$svc" 2>/dev/null \
                && Info "Enabled $svc" \
                || Warn "Could not enable $svc"
        fi
    done
}

# ── initramfs ─────────────────────────────────────────────────

DetectInitramfsTool() {
    if [ -f /etc/mkinitcpio.conf ]; then
        echo "mkinitcpio"
    elif command -v dracut &>/dev/null; then
        echo "dracut"
    else
        echo "unknown"
    fi
}

ConfigureMkinitcpio() {
    [ "$DRIVER_TYPE" = "nouveau" ] && return

    local tool
    tool=$(DetectInitramfsTool)

    case "$tool" in
        mkinitcpio) ConfigureMkinitcpioModules ;;
        dracut)     ConfigureDracut ;;
        *)
            Warn "No supported initramfs tool found (mkinitcpio or dracut)."
            Warn "  Add nvidia modules manually before rebooting!"
            ;;
    esac
}

ConfigureMkinitcpioModules() {
    local conf=/etc/mkinitcpio.conf
    local need="nvidia nvidia_modeset nvidia_uvm nvidia_drm"

    local current_line
    current_line=$(grep "^MODULES=" "$conf")
    [ -z "$current_line" ] && { Warn "MODULES= line not found in $conf."; return; }

    local missing=()
    for mod in $need; do
        echo "$current_line" | grep -q "\b$mod\b" || missing+=("$mod")
    done

    if [ ${#missing[@]} -eq 0 ]; then
        Info "NVIDIA modules already in mkinitcpio MODULES=() — no changes."
        return
    fi

    Info "Adding to mkinitcpio MODULES: ${missing[*]}"
    if [ "$DRY_RUN" = no ]; then
        local existing
        existing=$(echo "$current_line" | sed -E 's|^MODULES=\(([^)]*)\)|\1|')
        local combined
        combined=$(echo "$existing ${missing[*]}" | tr -s ' ' | sed 's/^ //')
        sed -i "s|^MODULES=(.*)|MODULES=($combined)|" "$conf"
        Info "Updated: MODULES=($combined)"
    else
        Note "[DRY RUN] Would add to mkinitcpio MODULES=(): ${missing[*]}"
    fi
}

ConfigureDracut() {
    local conf=/etc/dracut.conf.d/nvidia.conf
    local line='force_drivers+=" nvidia nvidia_modeset nvidia_uvm nvidia_drm "'

    if [ -f "$conf" ] && grep -q "nvidia" "$conf"; then
        Info "NVIDIA dracut config already exists at $conf"
        return
    fi

    Info "Writing dracut NVIDIA config → $conf"
    if [ "$DRY_RUN" = no ]; then
        mkdir -p /etc/dracut.conf.d
        echo "$line" > "$conf"
    else
        Note "[DRY RUN] Would write: $line  →  $conf"
    fi
}

# ── Execute ───────────────────────────────────────────────────

InstallPkg() {
    local pkg="$1"
    local cached
    cached=$(FindCachedPkg "$pkg")
    if [ -n "$cached" ]; then
        Info "  Installing from cache: $(basename "$cached")"
        pacman -U --needed --noconfirm "$cached"
    else
        pacman -S --needed --noconfirm "$pkg"
    fi
}

ExecuteChanges() {
    if [ ${#REMOVE[@]} -gt 0 ]; then
        Info "Removing conflicting packages: ${REMOVE[*]}"
        if [ "$DRY_RUN" = no ]; then
            pacman -Rns --noconfirm "${REMOVE[@]}" 2>/dev/null \
                || Warn "Some packages could not be removed (may be dependencies of others)."
        else
            Note "[DRY RUN] Would remove: ${REMOVE[*]}"
        fi
    fi

    if [ ${#INSTALL[@]} -gt 0 ]; then
        Info "Installing: ${INSTALL[*]}"
        if [ "$DRY_RUN" = no ]; then
            # Split packages into cached (pacman -U) and repo (pacman -S).
            # Install each group in ONE transaction so pacman handles
            # conflicts/provides atomically (e.g. equestria-nvidia-580xx-utils
            # replacing nvidia-utils while equestria-nvidia-580xx-dkms depends on it).
            local cached_files=()
            local repo_pkgs=()
            for pkg in "${INSTALL[@]}"; do
                local cached
                cached=$(FindCachedPkg "$pkg")
                if [ -n "$cached" ]; then
                    cached_files+=("$cached")
                else
                    repo_pkgs+=("$pkg")
                fi
            done

            local fail=no
            if [ ${#cached_files[@]} -gt 0 ]; then
                Info "  From cache: ${cached_files[*]##*/}"
                # --noconfirm alone answers "N" to conflict-resolution prompts
                # (e.g. "Remove nvidia-utils? [y/N]"), aborting the transaction.
                # Pipe 'yes' so pacman accepts replacing conflicting packages
                # (e.g. nvidia-utils → equestria-nvidia-580xx-utils).
                # --overwrite '*' handles file conflicts between split packages
                # (e.g. 580xx-utils ships files now owned by egl-gbm, egl-x11).
                yes | pacman -U --needed --overwrite '*' "${cached_files[@]}" || fail=yes
            fi
            if [ ${#repo_pkgs[@]} -gt 0 ]; then
                Info "  From repos: ${repo_pkgs[*]}"
                yes | pacman -S --needed --overwrite '*' "${repo_pkgs[@]}" || fail=yes
            fi

            if [ "$fail" = yes ]; then
                INSTALL_FAILED=yes
                if [ "$AUTO" = yes ]; then
                    Warn "Some packages could not be installed."
                    Warn "  Place pre-built packages in $DRIVER_CACHE_DIR/ to enable offline install."
                else
                    DIE "Package installation failed.\nCheck the output above."
                fi
            fi
        else
            for pkg in "${INSTALL[@]}"; do
                local cached
                cached=$(FindCachedPkg "$pkg")
                if [ -n "$cached" ]; then
                    Note "[DRY RUN] Would install from cache: $(basename "$cached")"
                else
                    Note "[DRY RUN] Would install from repos:  $pkg"
                fi
            done
        fi
    fi

    if [ ${#INSTALL[@]} -eq 0 ] && [ ${#REMOVE[@]} -eq 0 ]; then
        Info "All packages are already up to date — nothing to do."
    fi
}

# ── DKMS Verification ─────────────────────────────────────────
#
# Before rebuilding initramfs, verify that the NVIDIA DKMS module was
# actually compiled for the running kernel. If DKMS silently failed
# (e.g. missing kernel headers), mkinitcpio would bake in a missing/
# stale module and make the driver invisible after every reboot.

VerifyDkmsModule() {
    [ "$DRIVER_TYPE" = "nouveau" ] && return 0

    # Non-DKMS packages (e.g. --no-dkms path) don't need this check.
    [[ "$DRIVER_PKG" != *dkms* ]] && return 0

    if ! command -v dkms &>/dev/null; then
        Warn "dkms not found — cannot verify module build. Skipping initramfs rebuild."
        return 1
    fi

    local status
    status=$(dkms status 2>/dev/null)

    # dkms status format: "nvidia/570.x.y, 6.18.x, x86_64: installed"
    if echo "$status" | grep -qE "^nvidia[^,]*.+: installed"; then
        Info "DKMS: nvidia module verified as built and installed."
        return 0
    fi

    Warn "DKMS: nvidia module is NOT built for the current kernel."
    if [ -n "$status" ]; then
        Warn "  dkms status: $status"
    else
        Warn "  dkms status: <empty — module may not be registered at all>"
    fi
    Warn "  Skipping initramfs rebuild to avoid baking in a broken state."
    Warn "  Fix: install the matching kernel headers, then run:"
    Warn "    sudo dkms autoinstall && sudo mkinitcpio -P"
    return 1
}

RebuildInitramfs() {
    [ "$DRIVER_TYPE" = "nouveau" ] && return

    local tool
    tool=$(DetectInitramfsTool)

    case "$tool" in
        mkinitcpio)
            Info "Rebuilding initramfs with mkinitcpio -P ..."
            if [ "$DRY_RUN" = no ]; then
                mkinitcpio -P || Warn "mkinitcpio reported issues. Check output above."
            else
                Note "[DRY RUN] Would run: mkinitcpio -P"
            fi
            ;;
        dracut)
            Info "Rebuilding initramfs with dracut ..."
            if [ "$DRY_RUN" = no ]; then
                for kver_path in /usr/lib/modules/*/pkgbase; do
                    [ -f "$kver_path" ] || continue
                    local kver
                    kver=$(basename "$(dirname "$kver_path")")
                    Info "  → kernel $kver"
                    dracut --force "/boot/initramfs-$kver.img" "$kver" \
                        || Warn "dracut failed for $kver"
                done
            else
                Note "[DRY RUN] Would run: dracut --force for each installed kernel"
            fi
            ;;
        *)
            Warn "Cannot rebuild initramfs — no supported tool found."
            Warn "  Run 'mkinitcpio -P' or 'dracut' manually before rebooting!"
            ;;
    esac
}

# ── Summary ───────────────────────────────────────────────────

ShowSummary() {
    Header "PG GPU Sync — Plan"
    printf "  %-16s %s\n" "GPU:"       "${GPU_NAME:-not detected}"
    printf "  %-16s %s\n" "Family:"    "${GPU_FAMILY:-unknown} — $(FamilyName "$GPU_FAMILY")"
    printf "  %-16s %s\n" "Optimus:"   "$([ "$OPTIMUS" = yes ] && echo "yes (laptop iGPU + NVIDIA dGPU)" || echo "no")"
    printf "  %-16s %s\n" "Driver:"    "${DRIVER_PKG:-none (nouveau)}"
    printf "  %-16s %s\n" "Mode:"      "$([ "$DRY_RUN" = yes ] && echo "DRY RUN" || ([ "$AUTO" = yes ] && echo "AUTO (unattended)" || echo "Interactive"))"
    echo ""
    [ ${#INSTALL[@]} -gt 0 ] && printf "  %-16s %s\n" "To install:" "${INSTALL[*]}"
    [ ${#REMOVE[@]}  -gt 0 ] && printf "  %-16s %s\n" "To remove:"  "${REMOVE[*]}"
    echo ""
}

# ── Help ──────────────────────────────────────────────────────

ShowHelp() {
    cat <<EOF

  pg-gpu-sync — Equestria OS NVIDIA Driver Manager
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  Usage:  sudo pg-gpu-sync [options]

  Options:
    -h, --help          This help.
    -t, --test          Dry run — show what WOULD happen, change nothing.
    -a, --auto          Unattended mode for OS installer / live image.
                        No prompts. Legacy GPU packages must be in cache.
    -f, --force         Install even if no NVIDIA GPU detected.
    -n, --nouveau       Force the open-source nouveau driver.
        --no-dkms       Use non-DKMS package (nvidia/nvidia-open, linux/linux-lts only).
        --32            Add 32-bit support (Steam/Proton).
                        Requires [multilib] in /etc/pacman.conf.
        --no-settings   Skip nvidia-settings.
        --show-gpu      Print detected GPU info and exit.

  GPU support:
    Turing / Ampere / Ada / Blackwell  →  nvidia-open-dkms              (open, official repos)
    Maxwell / Pascal / Volta           →  equestria-nvidia-580xx-dkms   (Equestria repo, v580)
                                          nouveau                       (fallback if no pkg)
    Kepler  (GTX 600/700, GT 7xxM)    →  nvidia-470xx-dkms             (offline cache)
    Fermi   (GT 400/500, GT 5xxM)     →  nvidia-390xx-dkms             (offline cache)
    Older                              →  nouveau

  Note: NVIDIA 590+ dropped support for Maxwell/Pascal/Volta (pre-Turing).
        nvidia-open-dkms causes kernel panics on these GPUs.
        For GTX 10xx/900/750 series, equestria-nvidia-580xx-dkms is required.

  Offline cache:
    Place pre-built .pkg.tar.zst files in:
      $DRIVER_CACHE_DIR/
    Packages found there are installed with 'pacman -U' (no internet required).
    Recommended cache contents for offline installs:
      equestria-nvidia-580xx-dkms, equestria-nvidia-580xx-utils,
      lib32-equestria-nvidia-580xx-utils (for Steam/Proton)

EOF
}

# ── Options Parsing ───────────────────────────────────────────

ParseOptions() {
    FORCE=no
    DRY_RUN=no
    AUTO=no
    MODE="nvidia"
    NO_DKMS=no
    BIT32=no
    SETTINGS_PKG=yes

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)        ShowHelp; exit 0 ;;
            -t|--test)        DRY_RUN=yes ;;
            -a|--auto)        AUTO=yes ;;
            -f|--force)       FORCE=yes ;;
            -n|--nouveau)     MODE=nouveau ;;
            --no-dkms)        NO_DKMS=yes ;;
            --32)             BIT32=yes ;;
            --no-settings)    SETTINGS_PKG=no ;;
            --show-gpu)
                DetectGPU
                DetectOptimus
                echo "GPU     : ${GPU_NAME:-not detected}"
                echo "Family  : ${GPU_FAMILY:-unknown} — $(FamilyName "$GPU_FAMILY")"
                echo "Optimus : $([ "$OPTIMUS" = yes ] && echo "yes (iGPU + NVIDIA dGPU)" || echo "no")"
                exit 0
                ;;
            *) Warn "Unknown option: $1"; ShowHelp; exit 1 ;;
        esac
        shift
    done
}

# ── Main ──────────────────────────────────────────────────────

Main() {
    ParseOptions "$@"

    [ "$EUID" -ne 0 ] && DIE "Please run as root:  sudo pg-gpu-sync $*"

    INSTALL_FAILED=no

    Header "PG GPU Sync — Equestria OS"

    # 1. Detect GPU hardware
    Info "Scanning for NVIDIA GPU..."
    DetectGPU
    DetectOptimus

    [ -n "$GPU_NAME" ] && Info "Detected: $GPU_NAME  [family: ${GPU_FAMILY:-?}]"
    [ "$OPTIMUS" = yes ] && Info "Optimus detected — laptop with iGPU + NVIDIA dGPU"

    # 2. Choose the right driver
    SelectDriver

    if [ "$DRIVER_TYPE" = "skip" ]; then
        SaveGpuState
        # On non-NVIDIA systems: remove leftover NVIDIA packages and clean mkinitcpio
        if [ "$AUTO" = yes ] && [ "$DRY_RUN" = no ]; then
            local nvidia_pkgs=(nvidia-lts nvidia-open-dkms nvidia-open nvidia-dkms equestria-nvidia-dkms
                equestria-nvidia-580xx-dkms equestria-nvidia-580xx-utils lib32-equestria-nvidia-580xx-utils
                nvidia-utils lib32-nvidia-utils nvidia-settings)
            local to_remove=()
            for p in "${nvidia_pkgs[@]}"; do IsInstalled "$p" && to_remove+=("$p"); done
            if [ ${#to_remove[@]} -gt 0 ]; then
                Info "No NVIDIA GPU — removing NVIDIA packages: ${to_remove[*]}"
                pacman -Rns --noconfirm "${to_remove[@]}" 2>/dev/null || \
                    Warn "Some NVIDIA packages could not be removed (dependency conflict). Skipping."
            fi
            local conf=/etc/mkinitcpio.conf
            if [ -f "$conf" ] && grep -q "nvidia" "$conf"; then
                Info "Removing NVIDIA modules from $conf"
                sed -i 's/ nvidia nvidia_modeset nvidia_uvm nvidia_drm//g' "$conf"
                sed -i 's/nvidia nvidia_modeset nvidia_uvm nvidia_drm //g' "$conf"
                sed -i 's/\bnvidia\b//g; s/\bnvidia_modeset\b//g; s/\bnvidia_uvm\b//g; s/\bnvidia_drm\b//g' "$conf"
                sed -i 's/MODULES=(  */MODULES=(/g; s/  *)/)/g; s/   */ /g' "$conf"
                mkinitcpio -P 2>/dev/null || Warn "mkinitcpio reported issues."
            fi
        fi
        Info "No NVIDIA GPU — driver setup complete."
        exit 0
    fi

    # Fast path in --auto mode: skip if GPU hasn't changed AND driver is healthy.
    # Without the health check, a previously failed install would save the GPU
    # state and then skip all subsequent boot attempts silently.
    if [ "$AUTO" = yes ] && [ "$DRY_RUN" = no ]; then
        if ! GpuChanged; then
            # GPU family matches saved state — but verify driver is actually working.
            local _dkms_ok=yes
            if command -v dkms &>/dev/null; then
                dkms status 2>/dev/null | grep -qE "^nvidia[^,]*.+: installed" || _dkms_ok=no
            fi
            if [ "$_dkms_ok" = yes ]; then
                Info "GPU unchanged ($(FamilyName "$GPU_FAMILY")) — driver already configured."
                exit 0
            fi
            Info "GPU unchanged but DKMS module missing — re-running driver setup."
        fi
        [ -f "$STATE_FILE" ] && _GPU_WAS_SWAPPED=yes || _GPU_WAS_SWAPPED=no
    fi

    # 3. Find which kernel headers are missing
    CollectKernelHeaders

    # 4. Build install/remove lists
    BuildPackageLists

    # 5. Show the plan
    ShowSummary

    # 6. Confirm (skip in auto/dry-run mode)
    if [ "$DRY_RUN" = no ] && [ "$AUTO" = no ]; then
        read -rp "  Proceed? [Y/n] " confirm
        [[ "$confirm" =~ ^[Nn]$ ]] && { Info "Aborted."; exit 0; }
        echo ""
    fi

    # 7. Remove conflicting packages + install new ones
    ExecuteChanges

    # 7b. Retry DKMS build for equestria-nvidia-dkms (legacy fallback).
    # The package's post_install uses "|| true", so pacman reports success
    # even when the .run download fails (~400 MB from nvidia.com).
    # Detect this: package installed but DKMS module not built → retry.
    # Note: primary path for Pascal/Maxwell is now equestria-nvidia-580xx-dkms
    # which builds DKMS during makepkg (no runtime download). This retry
    # only applies if equestria-nvidia-dkms was used as a fallback.
    if [ "$INSTALL_FAILED" = no ] && IsInstalled equestria-nvidia-dkms; then
        if ! dkms status 2>/dev/null | grep -qE "^nvidia[^,]*.+: installed"; then
            Info "equestria-nvidia-dkms installed but DKMS module not built — retrying download..."
            if /usr/lib/equestria-nvidia-dkms/equestria-nvidia-dkms-update --no-initramfs; then
                Info "DKMS module built successfully on retry."
            else
                INSTALL_FAILED=yes
                Warn "NVIDIA .run download/build failed. Internet required."
            fi
        fi
    fi

    # 8–13. Configure the system for NVIDIA — but ONLY if the driver
    # is fully working.  We check BOTH INSTALL_FAILED (pacman-level failure)
    # and VerifyDkmsModule (DKMS-level failure, e.g. .run download succeeded
    # but kernel module compilation failed).
    #
    # If driver is broken, we must NOT blacklist nouveau — it's the only
    # working GPU driver.  Without this guard the system boots into
    # software rendering (no nouveau, no nvidia → no KWin animations,
    # no Proton, no GPU acceleration at all).
    if [ "${INSTALL_FAILED}" = yes ]; then
        Warn "Driver installation was incomplete — skipping all NVIDIA configuration."
        Warn "  Nouveau will remain active as fallback."
        Warn "  GPU state NOT saved. The service will retry on the next boot."
        Warn "  Ensure network access or place packages in $DRIVER_CACHE_DIR/"
    elif ! VerifyDkmsModule; then
        Warn "DKMS module not verified — skipping all NVIDIA configuration."
        Warn "  Nouveau will remain active as fallback."
        Warn "  GPU state NOT saved. The service will retry on the next boot."
    else
        # 8. Nouveau blacklist
        ConfigureNouveauBlacklist

        # 9. Wayland modeset config (generation-aware)
        ConfigureWayland

        # 10. KDE KWin compositor config for NVIDIA
        ConfigureKwinCompositor

        # 11. Enable nvidia suspend/resume/hibernate systemd services
        EnableNvidiaSleepServices

        # 12+13. mkinitcpio config + initramfs rebuild
        ConfigureMkinitcpio
        RebuildInitramfs
        SaveGpuState
    fi

    Header "Done!"
    if [ "$DRY_RUN" = yes ]; then
        Note "Dry run complete — nothing was changed on your system."
    elif [ "$AUTO" = yes ] && [ "${_GPU_WAS_SWAPPED:-no}" = yes ]; then
        Info "GPU was swapped — rebooting in 5 seconds to apply new driver..."
        sleep 5
        systemctl reboot
    else
        Info "Done. Please reboot."
        Info "  sudo reboot"
    fi
}

Main "$@"
