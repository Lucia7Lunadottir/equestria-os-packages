# Maintainer: Equestria OS Team <info@psyche-games.com>

pkgname=equestria-os-branding
pkgver=1.5.0
pkgrel=1
pkgdesc="Official Equestria OS Visual Style (SDDM, GRUB, Plasma day/night global themes, cursors, KDE defaults)"
arch=('any')
url="https://github.com/Lucia7Lunadottir"
license=('custom')

provides=('equestria-os-branding')
install=equestria-os-branding.install
backup=('etc/xdg/kdeglobals' 'etc/xdg/kcminputrc' 'etc/xdg/ksplashrc'
        'etc/sddm.conf.d/10-equestria-os.conf')
source=()

package() {
    # 1. SDDM тема + курсор экрана входа
    if [ -d "$startdir/sddm/equestria-os-breeze" ]; then
        install -d "$pkgdir/usr/share/sddm/themes"
        cp -r "$startdir/sddm/equestria-os-breeze" "$pkgdir/usr/share/sddm/themes/"
    fi
    install -Dm644 "$startdir/sddm-conf/10-equestria-os.conf" "$pkgdir/etc/sddm.conf.d/10-equestria-os.conf"

    # 2. GRUB тема
    if [ -d "$startdir/grub/equestria-os" ]; then
        install -d "$pkgdir/usr/share/grub/themes"
        cp -r "$startdir/grub/equestria-os" "$pkgdir/usr/share/grub/themes/"
    fi

    # 3. Глобальные темы Plasma: Equestria-OS (день) и Equestria-OS-Dark (ночь).
    # В них только цвета, курсор и заставка — то, что KDE меняет утром и вечером.
    # Экраны блокировки и выключения — родные из Plasma: свои копии устаревали
    # с каждым обновлением и давали разную яркость в разных темах.
    install -d "$pkgdir/usr/share/plasma/look-and-feel"
    cp -r "$startdir/look-and-feel/Equestria-OS" "$startdir/look-and-feel/Equestria-OS-Dark" \
        "$pkgdir/usr/share/plasma/look-and-feel/"

    # 3a. Системные умолчания KDE (/etc/xdg). Пользовательские файлы в ~/.config
    # главнее; если их сбросить или испортить, KDE вернётся к этим, а не к Breeze.
    install -Dm644 "$startdir/ksplashrc" "$pkgdir/etc/xdg/ksplashrc"
    install -Dm644 "$startdir/xdg/kdeglobals" "$pkgdir/etc/xdg/kdeglobals"
    install -Dm644 "$startdir/xdg/kcminputrc" "$pkgdir/etc/xdg/kcminputrc"

    # 4. Самопроверка SDDM-темы с откатом на Breeze при поломке
    install -Dm755 "$startdir/scripts/sddm-selfcheck.sh" \
        "$pkgdir/usr/lib/equestria-os/sddm-selfcheck.sh"
    install -Dm644 "$startdir/hooks/equestria-os-sddm-selfcheck.hook" \
        "$pkgdir/usr/share/libalpm/hooks/equestria-os-sddm-selfcheck.hook"

    # 5. Cutiemarks
    install -d "$pkgdir/usr/share/equestria-os/cutiemarks"
    if [ -d "$startdir/cutiemarks" ]; then
        cp -r "$startdir/cutiemarks/"* "$pkgdir/usr/share/equestria-os/cutiemarks/" 2>/dev/null || true
    fi

    # 6. Курсоры: Vimix-white (день) и Vimix (ночь)
    install -d "$pkgdir/usr/share/icons"
    cp -r "$startdir/icons/Vimix-white-cursors" "$startdir/icons/Vimix-cursors" "$pkgdir/usr/share/icons/"

    # 7. Только уникальные наши pixmaps
    install -d "$pkgdir/usr/share/pixmaps"
    for f in \
        equestria-os.png \
        equestria-os-character-theme.png \
        equestria-os-package-installer.png; do
        if [ -f "$startdir/pixmaps/$f" ]; then
            install -Dm644 "$startdir/pixmaps/$f" "$pkgdir/usr/share/pixmaps/$f"
        fi
    done

    # 8. Kickoff/меню приложений: перекрываем стартовую иконку KDE логотипом.
    # Каталог /usr/share/equestria-os/xdg добавляется в XDG_DATA_DIRS раньше
    # /usr/share (см. scripts/equestria-os-xdg.sh), поэтому эти файлы
    # выигрывают у breeze-icons, не затирая файлы чужого пакета.
    # Внимание: каталог размера должен быть ОБЪЯВЛЕН в index.theme breeze,
    # иначе он невидим для поиска (places/24, например, не объявлен).
    local _master="$pkgdir/usr/share/equestria-os/xdg/icons/equestria-start-here.svg"
    install -dm755 "$(dirname "$_master")"
    {
        printf '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="96" height="96" viewBox="0 0 96 96">\n'
        printf '  <image width="96" height="96" xlink:href="data:image/png;base64,%s"/>\n' "$(base64 -w0 "$startdir/pixmaps/equestria-os-logo.png")"
        printf '</svg>\n'
    } > "$_master"
    local _theme _d _n _icondir
    for _theme in breeze breeze-dark; do
        for _d in 16 16@2x 16@3x 22 22@2x 22@3x 32 48 64 96; do
            _icondir="$pkgdir/usr/share/equestria-os/xdg/icons/$_theme/places/$_d"
            install -dm755 "$_icondir"
            for _n in start-here-kde start-here-kde-symbolic start-here-kde-plasma \
                      start-here-kde-plasma-symbolic start-here-symbolic; do
                ln -s ../../../equestria-start-here.svg "$_icondir/$_n.svg"
            done
        done
    done

    # 8a. Скрипт profile.d, включающий каталог переопределений
    install -Dm644 "$startdir/scripts/equestria-os-xdg.sh" \
        "$pkgdir/etc/profile.d/equestria-os-xdg.sh"

    # 9. App submenu
    install -Dm644 "$startdir/equestria-os.directory" \
        "$pkgdir/usr/share/desktop-directories/equestria-os.directory"
    install -Dm644 "$startdir/equestria-os.menu" \
        "$pkgdir/etc/xdg/menus/applications-merged/equestria-os.menu"
    install -Dm644 "$startdir/equestria-os.menu" \
        "$pkgdir/etc/xdg/menus/plasma-applications-merged/equestria-os.menu"


    # --- ИСПРАВЛЕННЫЙ БЛОК PLYMOUTH БЕЗ КОНФЛИКТОВ ---

    # 1. Сгружаем все "эталонные" файлы брендинга в твою изолированную папку
    install -dm755 "$pkgdir/usr/share/equestria-os/branding"
    install -m644 "$startdir/watermark.png" "$pkgdir/usr/share/equestria-os/branding/watermark.png"
    install -m644 "$startdir/plymouthd.conf" "$pkgdir/usr/share/equestria-os/branding/plymouthd.conf"
    # Копируем исправленный конфиг темы в безопасное место
    install -m644 "$startdir/spinner.plymouth" "$pkgdir/usr/share/equestria-os/branding/spinner.plymouth"

    # 2. Устанавливаем системный скрипт автоматизации
    install -Dm755 "$startdir/equestria-os-plymouth-fix" "$pkgdir/usr/bin/equestria-os-plymouth-fix"

    # 3. Устанавливаем хук, который будет дергать этот скрипт
    #    Имя 80- гарантирует запуск ДО 90-mkinitcpio-install.hook,
    #    чтобы initramfs собирался уже с нашим брендингом.
    install -Dm644 "$startdir/plymouth-branding.hook" "$pkgdir/usr/share/libalpm/hooks/80-equestria-plymouth-branding.hook"
}
