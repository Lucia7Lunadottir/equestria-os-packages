[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = plymouth
Target = mkinitcpio
Target = equestria-os-branding

[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Restoring Equestria OS Plymouth branding before initramfs rebuild...
When = PostTransaction
Exec = /usr/bin/equestria-os-plymouth-fix