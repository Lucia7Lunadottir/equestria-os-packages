# Maintainer: Equestria OS Team
#
# Legacy NVIDIA proprietary driver — last branch supporting Pascal/Maxwell/Volta.
#
# NVIDIA 590+ dropped Pascal (GTX 10xx) and Maxwell (GTX 900/750) support.
# This package provides the last working driver (580.x) for these GPUs.
#
# Split package (дробление нужно, чтобы каждый файл пакета был < 100 МБ —
# лимит GitHub на файл в репозитории):
#   equestria-nvidia-580xx-utils   — GL/Vulkan/VDPAU + X11 (ядро для игр/Proton)
#   equestria-nvidia-580xx-dkms    — DKMS kernel modules
#   equestria-nvidia-580xx-compute — CUDA / OpenCL / NVENC / NVDEC (опционально)
#   equestria-nvidia-580xx-optix   — OptiX / ray tracing (опционально, тянет compute)
#
# .run file is downloaded at `makepkg` time — no LFS, only this PKGBUILD in git.

pkgbase=equestria-nvidia-580xx
pkgname=('equestria-nvidia-580xx-utils' 'equestria-nvidia-580xx-dkms'
         'equestria-nvidia-580xx-compute' 'equestria-nvidia-580xx-optix')

# Библиотеки, уходящие в -compute (CUDA-стек; NVENC/NVDEC зависят от libcuda)
_compute_re='^(libcuda|libcudadebugger|libnvidia-opencl|libnvidia-nvvm|libnvidia-ptxjitcompiler|libnvcuvid|libnvidia-encode|libnvidia-opticalflow)\.so\.'
# Библиотеки, уходящие в -optix
_optix_re='^(libnvoptix|libnvidia-rtcore)\.so\.'
pkgver=580.173.02
pkgrel=3
arch=('x86_64')
url='https://www.nvidia.com/'
license=('LicenseRef-NVIDIA-proprietary')
options=('!strip')

_pkg="NVIDIA-Linux-x86_64-${pkgver}"

source=("https://download.nvidia.com/XFree86/Linux-x86_64/${pkgver}/${_pkg}.run")
sha256sums=('SKIP')

prepare() {
    # NVIDIA's .run script uses $0 without quoting internally —
    # breaks when ANY part of the path contains spaces.
    # Symlink to /tmp so the .run sees a clean path.
    local _work="/tmp/equestria-nvidia-build-$$"
    rm -rf "$_work"
    mkdir -p "$_work"
    ln -sf "${srcdir}/${_pkg}.run" "$_work/${_pkg}.run"
    cd "$_work"
    bash "${_work}/${_pkg}.run" --extract-only
    rm -rf "${srcdir}/${_pkg}"
    mv "$_work/${_pkg}" "${srcdir}/${_pkg}"
    rm -rf "$_work"
}

# ── nvidia-580xx-utils ────────────────────────────────────────────

package_equestria-nvidia-580xx-utils() {
    pkgdesc="NVIDIA 580.x userspace libraries and tools (legacy: Pascal/Maxwell/Volta)"
    depends=('libglvnd' 'egl-wayland' 'egl-gbm' 'egl-x11')
    optdepends=('nvidia-settings: GUI settings panel'
                'equestria-nvidia-580xx-compute: CUDA / OpenCL / NVENC / NVDEC'
                'equestria-nvidia-580xx-optix: OptiX ray tracing (Blender и т.п.)')
    provides=("nvidia-utils=${pkgver}" "vulkan-driver" "opengl-driver")
    conflicts=('nvidia-utils')
    replaces=()

    cd "${srcdir}/${_pkg}"

    # ── Binaries ──────────────────────────────────────────────
    # (nvidia-cuda-mps-* уехали в -compute)
    for _bin in nvidia-smi nvidia-debugdump nvidia-persistenced; do
        [ -f "$_bin" ] && install -Dm755 "$_bin" "$pkgdir/usr/bin/$_bin"
    done
    [ -f nvidia-modprobe ] && install -Dm4755 nvidia-modprobe "$pkgdir/usr/bin/nvidia-modprobe"

    # ── Versioned .so libraries (кроме compute/optix) ─────────
    # Single loop: install every lib*.so.<pkgver>, create .so.1 symlink.
    for _lib in lib*.so.${pkgver}; do
        [ -f "$_lib" ] || continue
        # Skip non-GLVND libs — these are provided by libglvnd
        case "$_lib" in
            libEGL.so.*|libGLESv1_CM.so.*|libGLESv2.so.*|libGL.so.*|libGLX.so.*|libOpenGL.so.*) continue ;;
            # Xorg GLX-модуль ставится отдельно в /usr/lib/nvidia/xorg —
            # копия в /usr/lib не нужна (раньше дублировался, +13 МБ)
            libglxserver_nvidia.so.*) continue ;;
        esac
        # CUDA/OptiX-стек — в подпакетах -compute и -optix
        [[ "$_lib" =~ $_compute_re ]] && continue
        [[ "$_lib" =~ $_optix_re ]] && continue
        install -Dm755 "$_lib" "$pkgdir/usr/lib/$_lib"
        local _base="${_lib%.so.*}.so"
        ln -sf "$_lib" "$pkgdir/usr/lib/${_base}.1"
    done

    # GLVND compat symlinks (.so.0 / .so.2)
    ln -sf "libGLX_nvidia.so.${pkgver}"  "$pkgdir/usr/lib/libGLX_nvidia.so.0"
    ln -sf "libEGL_nvidia.so.${pkgver}"  "$pkgdir/usr/lib/libEGL_nvidia.so.0"
    [ -f "$pkgdir/usr/lib/libGLESv2_nvidia.so.${pkgver}" ] && \
        ln -sf "libGLESv2_nvidia.so.${pkgver}" "$pkgdir/usr/lib/libGLESv2_nvidia.so.2"
    [ -f "$pkgdir/usr/lib/libGLESv1_CM_nvidia.so.${pkgver}" ] && \
        ln -sf "libGLESv1_CM_nvidia.so.${pkgver}" "$pkgdir/usr/lib/libGLESv1_CM_nvidia.so.1"

    # Non-versioned NVIDIA libs (libnvidia-nvvm70 уехала в -compute)
    for _lib in libnvidia-api.so.1; do
        [ -f "$_lib" ] && install -Dm755 "$_lib" "$pkgdir/usr/lib/$_lib"
    done

    # GBM backend — загрузчик Mesa ищет /usr/lib/gbm/nvidia-drm_gbm.so.
    # Без этого симлинка kwin_wayland не может открыть рендер-устройство
    # и сессия Plasma падает сразу после логина (логин-луп).
    install -dm755 "$pkgdir/usr/lib/gbm"
    ln -sf ../libnvidia-allocator.so.1 "$pkgdir/usr/lib/gbm/nvidia-drm_gbm.so"

    # EGL platform plugins — provided by egl-wayland, egl-gbm, egl-x11 packages.
    # Do NOT install them here to avoid file conflicts.

    # VDPAU (goes to /usr/lib/vdpau/)
    [ -f "libvdpau_nvidia.so.${pkgver}" ] && {
        install -Dm755 "libvdpau_nvidia.so.${pkgver}" "$pkgdir/usr/lib/vdpau/libvdpau_nvidia.so.${pkgver}"
        ln -sf "libvdpau_nvidia.so.${pkgver}" "$pkgdir/usr/lib/vdpau/libvdpau_nvidia.so.1"
    }

    # OptiX — в подпакете equestria-nvidia-580xx-optix

    # ── JSON configs ──────────────────────────────────────────
    install -Dm644 nvidia_icd.json "$pkgdir/usr/share/vulkan/icd.d/nvidia_icd.json"
    install -Dm644 10_nvidia.json "$pkgdir/usr/share/glvnd/egl_vendor.d/10_nvidia.json"
    [ -f nvidia_layers.json ] && install -Dm644 nvidia_layers.json "$pkgdir/usr/share/vulkan/implicit_layer.d/nvidia_layers.json"
    # EGL external platform JSONs — provided by egl-wayland, egl-gbm, egl-x11.
    # Do NOT install them here to avoid file conflicts.

    # OpenCL ICD — в подпакете equestria-nvidia-580xx-compute

    # ── Xorg ──────────────────────────────────────────────────
    [ -f nvidia_drv.so ] && install -Dm755 nvidia_drv.so "$pkgdir/usr/lib/xorg/modules/drivers/nvidia_drv.so"
    [ -f "libglxserver_nvidia.so.${pkgver}" ] && {
        install -Dm755 "libglxserver_nvidia.so.${pkgver}" "$pkgdir/usr/lib/nvidia/xorg/libglxserver_nvidia.so.${pkgver}"
        ln -sf "libglxserver_nvidia.so.${pkgver}" "$pkgdir/usr/lib/nvidia/xorg/libglxserver_nvidia.so"
    }
    [ -f nvidia-drm-outputclass.conf ] && install -Dm644 nvidia-drm-outputclass.conf "$pkgdir/usr/share/X11/xorg.conf.d/10-nvidia-drm-outputclass.conf"

    # ── Firmware (GSP) — НЕ устанавливаем ─────────────────────
    # GSP-прошивки нужны только Turing и новее, а эти GPU обслуживает
    # nvidia-open из официальных репозиториев. Pascal/Maxwell/Volta
    # (целевые GPU этого пакета) GSP не используют вообще.
    # Бонус: без прошивок пакет помещается в лимит GitHub 100 МБ на файл.

    # ── systemd ───────────────────────────────────────────────
    for _svc in nvidia-suspend nvidia-resume nvidia-hibernate; do
        [ -f "${_svc}.service" ] && install -Dm644 "${_svc}.service" "$pkgdir/usr/lib/systemd/system/${_svc}.service"
    done
    [ -f nvidia-sleep.sh ] && install -Dm755 nvidia-sleep.sh "$pkgdir/usr/lib/systemd/system-sleep/nvidia-sleep.sh"

    # nvidia-settings — provided by separate 'nvidia-settings' package.
    # Do NOT install here to avoid file conflicts.

    # ── Application profiles ──────────────────────────────────
    [ -f "nvidia-application-profiles-${pkgver}-rc" ] && \
        install -Dm644 "nvidia-application-profiles-${pkgver}-rc" "$pkgdir/usr/share/nvidia/nvidia-application-profiles-rc"
    [ -f "nvidia-application-profiles-${pkgver}-key-documentation" ] && \
        install -Dm644 "nvidia-application-profiles-${pkgver}-key-documentation" "$pkgdir/usr/share/nvidia/nvidia-application-profiles-key-documentation"

    # ── License ───────────────────────────────────────────────
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}

# ── nvidia-580xx-dkms ─────────────────────────────────────────────

package_equestria-nvidia-580xx-dkms() {
    pkgdesc="NVIDIA 580.x DKMS kernel modules (legacy: Pascal/Maxwell/Volta)"
    depends=("equestria-nvidia-580xx-utils=${pkgver}" 'dkms')
    provides=('NVIDIA-MODULE' "nvidia-dkms=${pkgver}")
    conflicts=('nvidia-open-dkms' 'nvidia-open' 'nvidia-open-lts'
               'nvidia-dkms' 'nvidia' 'nvidia-lts'
               'equestria-nvidia-dkms')

    cd "${srcdir}/${_pkg}/kernel"

    local _dkms_dir="$pkgdir/usr/src/nvidia-${pkgver}"
    install -dm755 "$_dkms_dir"

    # Copy all kernel module source
    cp -a . "$_dkms_dir/"

    # Generate dkms.conf
    cat > "$_dkms_dir/dkms.conf" <<DKMSEOF
PACKAGE_NAME="nvidia"
PACKAGE_VERSION="${pkgver}"

BUILT_MODULE_NAME[0]="nvidia"
BUILT_MODULE_LOCATION[0]=""
DEST_MODULE_LOCATION[0]="/kernel/drivers/video"

BUILT_MODULE_NAME[1]="nvidia-modeset"
BUILT_MODULE_LOCATION[1]=""
DEST_MODULE_LOCATION[1]="/kernel/drivers/video"

BUILT_MODULE_NAME[2]="nvidia-uvm"
BUILT_MODULE_LOCATION[2]=""
DEST_MODULE_LOCATION[2]="/kernel/drivers/video"

BUILT_MODULE_NAME[3]="nvidia-drm"
BUILT_MODULE_LOCATION[3]=""
DEST_MODULE_LOCATION[3]="/kernel/drivers/video"

BUILT_MODULE_NAME[4]="nvidia-peermem"
BUILT_MODULE_LOCATION[4]=""
DEST_MODULE_LOCATION[4]="/kernel/drivers/video"

# 'make' в кавычках — обязательно: иначе DKMS подставит KERNELRELEASE=<ver>
# в команду, Makefile NVIDIA решит, что его вызвал Kbuild, и упадёт на
# "include \$(src)/Kbuild" (см. dkms(8), секция MAKE).
MAKE[0]="'make' -j\$(nproc) SYSSRC=\${kernel_source_dir} KERNEL_UNAME=\${kernelver} IGNORE_PREEMPT_RT_PRESENCE=1 NV_EXCLUDE_BUILD_MODULES='' modules"
CLEAN="'make' SYSSRC=\${kernel_source_dir} clean"
AUTOINSTALL="yes"
DKMSEOF

    install -Dm644 "${srcdir}/${_pkg}/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}

# ── nvidia-580xx-compute ──────────────────────────────────────────

package_equestria-nvidia-580xx-compute() {
    pkgdesc="NVIDIA 580.x CUDA / OpenCL / NVENC / NVDEC libraries (legacy: Pascal/Maxwell/Volta)"
    depends=("equestria-nvidia-580xx-utils=${pkgver}")
    provides=("opencl-nvidia=${pkgver}" "opencl-driver" "cuda-driver")
    conflicts=('opencl-nvidia')

    cd "${srcdir}/${_pkg}"

    # MPS-демоны CUDA
    for _bin in nvidia-cuda-mps-control nvidia-cuda-mps-server; do
        [ -f "$_bin" ] && install -Dm755 "$_bin" "$pkgdir/usr/bin/$_bin"
    done

    for _lib in lib*.so.${pkgver}; do
        [ -f "$_lib" ] || continue
        [[ "$_lib" =~ $_compute_re ]] || continue
        install -Dm755 "$_lib" "$pkgdir/usr/lib/$_lib"
        local _base="${_lib%.so.*}.so"
        ln -sf "$_lib" "$pkgdir/usr/lib/${_base}.1"
    done

    # .so → .so.1 (для -lcuda, -lnvcuvid и т.д.)
    for _name in libcuda libnvcuvid libnvidia-encode libnvidia-opencl \
                 libnvidia-ptxjitcompiler libcudadebugger; do
        [ -L "$pkgdir/usr/lib/${_name}.so.1" ] && \
            ln -sf "${_name}.so.1" "$pkgdir/usr/lib/${_name}.so"
    done

    # NVVM-компилятор (не имеет версии pkgver в имени)
    [ -f libnvidia-nvvm70.so.4 ] && install -Dm755 libnvidia-nvvm70.so.4 \
        "$pkgdir/usr/lib/libnvidia-nvvm70.so.4"

    # ── OpenCL ICD ────────────────────────────────────────────
    install -dm755 "$pkgdir/etc/OpenCL/vendors"
    echo "libnvidia-opencl.so.1" > "$pkgdir/etc/OpenCL/vendors/nvidia.icd"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}

# ── nvidia-580xx-optix ────────────────────────────────────────────

package_equestria-nvidia-580xx-optix() {
    pkgdesc="NVIDIA 580.x OptiX / ray tracing libraries (legacy: Pascal/Maxwell/Volta)"
    depends=("equestria-nvidia-580xx-compute=${pkgver}")

    cd "${srcdir}/${_pkg}"

    for _lib in lib*.so.${pkgver}; do
        [ -f "$_lib" ] || continue
        [[ "$_lib" =~ $_optix_re ]] || continue
        install -Dm755 "$_lib" "$pkgdir/usr/lib/$_lib"
        local _base="${_lib%.so.*}.so"
        ln -sf "$_lib" "$pkgdir/usr/lib/${_base}.1"
    done

    [ -f nvoptix.bin ] && install -Dm644 nvoptix.bin "$pkgdir/usr/share/nvidia/nvoptix.bin"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
