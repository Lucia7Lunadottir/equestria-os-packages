pkgname=equestria-installer
pkgver=1.0.3
pkgrel=1
pkgdesc="Graphical local package installer for Equestria OS"
arch=('any')
url="https://github.com/Lucia7Lunadottir"
license=('GPL3')
depends=('python' 'python-pyqt6' 'polkit')
makedepends=('qt6-tools')

source=('installer.py'
        'equestria-installer.desktop'
        'Installer.svg')

sha256sums=('SKIP' 'SKIP' 'SKIP')

_languages=('ru_RU' 'uk_UA' 'de_DE' 'en_US' 'es_ES' 'fr_FR' 'pl_PL' 'it_IT' 'kk_KZ' 'zh_CN' 'ja_JP')

build() {
    cd "${srcdir}"

    local lang
    for lang in "${_languages[@]}"; do
        if [ -f "${startdir}/translations/${lang}.ts" ]; then
            /usr/lib/qt6/bin/lrelease "${startdir}/translations/${lang}.ts" -qm "${lang}.qm"
        fi
    done
}

package() {
    cd "${srcdir}"

    install -Dm755 installer.py "${pkgdir}/usr/bin/equestria-installer"

    # 2. Desktop-файл
    install -Dm644 equestria-installer.desktop "${pkgdir}/usr/share/applications/equestria-installer.desktop"

    # 3. Иконка (тема hicolor, чтобы QIcon.fromTheme находила её)
    install -Dm644 Installer.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/equestria-installer.svg"

    local lang
    for lang in "${_languages[@]}"; do
        if [ -f "${lang}.qm" ]; then
            install -Dm644 "${lang}.qm" "${pkgdir}/usr/share/equestria-installer/translations/${lang}.qm"
        fi
    done
}
