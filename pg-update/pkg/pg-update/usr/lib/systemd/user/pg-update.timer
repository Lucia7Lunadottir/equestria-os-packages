[Unit]
Description=Equestria OS — Check for updates every hour

[Timer]
# OnActiveSec (не OnBootSec!) — отсчитывается от момента активации
# самого таймера, а не от загрузки системы. Значит галочка "включить"
# и смена интервала в настройках (оба делают systemctl start/restart
# на этом юните) всегда гарантированно ставят первый прогон, а не
# только один раз за сессию после старта ОС.
OnActiveSec=5min
OnUnitActiveSec=1h
Unit=pg-update.service

[Install]
WantedBy=timers.target
